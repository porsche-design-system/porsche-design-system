# Strict peer dependency resolution (npm 7+ default) is enabled.
# We intentionally do NOT use legacy-peer-deps/force.
# Known peer-dependency mismatches are resolved explicitly via the
# "overrides" field in the root package.json (e.g. madge's optional
# TypeScript peer). See docs/dependencies.md for details.

# Supply-chain cooldown: only install versions that have been on the registry
# for more than 7 days (npm >= 11.10.0, value in DAYS). Compromised releases are
# typically unpublished/remediated within 1-3 days, so waiting a week filters out
# the bulk of registry-side supply-chain attacks at no cost for our weekly update
# rhythm. `npm ci` resolves from the lockfile and is NOT affected, so CI and
# container builds behave exactly as before.
# The same window is configured for the two other ways new versions enter this
# repo: `cooldown.default-days` in .github/dependabot.yml and `minimumReleaseAge`
# in .syncpackrc.json. See docs/dependencies.md -> "Release-age cooldown".
min-release-age=7
