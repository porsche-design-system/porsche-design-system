    "build-prod": "npm run build:core-dependencies-prod && concurrently -n 'components' 'npm run build:components-prod' && concurrently -n 'components-js' 'npm run build:components-js-prod' && concurrently --kill-others-on-fail -n 'components-angular,components-react,components-vue' 'npm run build:components-angular' 'npm run build:components-react' 'npm run build:components-vue' && npm run build:storefront",
    "build:core-dependencies": "npm run build:shared && npm run build:tokens && npm run build:assets && npm run build:styles && npm run build:utilities && npm run build:component-meta",
    "build:core-dependencies-prod": "npm run build:shared && npm run build:tokens && npm run build:assets && npm run build:styles-prod && npm run build:utilities && npm run build:component-meta",
