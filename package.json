  "scripts": {
    "prepare-release": "tsx scripts/prepare-release.ts",
    "preinstall": "npm run preinstall:assets && npm run preinstall:components-manager-cli && npm run preinstall:components-js && npm run preinstall:components-angular && npm run preinstall:components-react && npm run preinstall:components-vue && npm run preinstall:shared",
    "preinstall:assets": "mkdir -p ./packages/assets/bin && touch ./packages/assets/bin/serve-cdn.js",
    "preinstall:components-manager-cli": "mkdir -p ./packages/components-js/projects/components-manager-cli/dist/bin && touch ./packages/components-js/projects/components-manager-cli/dist/bin/cm.js",
    "preinstall:components-js": "TARGET=./packages/components-js/dist/components-wrapper && mkdir -p $TARGET && cp ./packages/components-js/projects/components-wrapper/package.json $TARGET",
    "preinstall:components-angular": "TARGET=./packages/components-angular/dist/angular-wrapper && mkdir -p $TARGET && cp ./packages/components-angular/projects/angular-wrapper/package.json $TARGET",
    "preinstall:components-react": "TARGET=./packages/components-react/dist/react-wrapper && mkdir -p $TARGET && cp ./packages/components-react/projects/react-wrapper/package.json $TARGET && mkdir -p $TARGET/bin && touch $TARGET/bin/patchRemixRunProcessBrowserGlobalIdentifier.js",
    "preinstall:components-vue": "TARGET=./packages/components-vue/dist/vue-wrapper && mkdir -p $TARGET && cp ./packages/components-vue/projects/vue-wrapper/package.json $TARGET",
    "preinstall:shared": "TARGET=./packages/shared/dist && mkdir -p $TARGET && sed -E -e \"s^shared^@porsche-design-system/shared^\" ./packages/shared/package.json > $TARGET/package.json && mkdir -p ./packages/shared/bin && touch ./packages/shared/bin/serve-dummyassets.js && touch ./packages/shared/bin/prepareVRTSnapshots.js",
    "postinstall": "patch-package && npm run postinstall:bin-links",
    "postinstall:bin-links": "chmod +x ./packages/assets/bin/serve-cdn.js ./packages/shared/bin/serve-dummyassets.js ./packages/shared/bin/prepareVRTSnapshots.js 2>/dev/null; ln -sf ../../packages/assets/bin/serve-cdn.js ./node_modules/.bin/serve-cdn; ln -sf ../../packages/shared/bin/serve-dummyassets.js ./node_modules/.bin/serve-dummyassets; ln -sf ../../packages/shared/bin/prepareVRTSnapshots.js ./node_modules/.bin/prepare-vrt-snapshots; true",
    "start:components": "npm run start --workspace=@porsche-design-system/components",
    "start:components-js": "npm run start --workspace=@porsche-design-system/js",
    "start:components-angular": "npm run start --workspace=@porsche-design-system/angular",
    "start:components-react": "npm run start --workspace=@porsche-design-system/react",
    "start:components-react/nextjs": "npm run start --workspace=@porsche-design-system/nextjs",
    "start:components-react/react-router": "npm run start --workspace=@porsche-design-system/react-router",
    "start:components-vue": "npm run start --workspace=@porsche-design-system/vue",
    "start:storefront": "npm run dev --workspace=@porsche-design-system/storefront",
    "build": "npm run build:core-dependencies && concurrently -n 'components' 'npm run build:components' && npm run build:skills && concurrently -n 'components-js' 'npm run build:components-js' && concurrently --kill-others-on-fail -n 'components-angular,components-react,components-vue' 'npm run build:components-angular' 'npm run build:components-react' 'npm run build:components-vue' && npm run build:storefront",
    "build-prod": "npm run build:core-dependencies-prod && concurrently -n 'components' 'npm run build:components-prod' && npm run build:skills && concurrently -n 'components-js' 'npm run build:components-js-prod' && concurrently --kill-others-on-fail -n 'components-angular,components-react,components-vue' 'npm run build:components-angular' 'npm run build:components-react' 'npm run build:components-vue' && npm run build:storefront",
    "build:core-dependencies": "npm run build:shared && npm run build:tokens && npm run build:assets && npm run build:styles && npm run build:utilities && npm run build:stylesheets && npm run build:component-meta",
    "build:core-dependencies-prod": "npm run build:shared && npm run build:tokens && npm run build:assets && npm run build:styles-prod && npm run build:utilities && npm run build:stylesheets-prod && npm run build:component-meta",
