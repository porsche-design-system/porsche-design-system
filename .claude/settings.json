{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "WebSearch",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git rev-parse*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(biome *)",
      "Bash(mkdir -p *)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Glob(**/node_modules/**)",
      "Grep(**/node_modules/**)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git tag *)",
      "Bash(git branch -D *)",
      "Bash(git clean *)",
      "Bash(git stash drop*)",
      "Bash(chmod 777 *)",
      "Bash(npm publish*)",
      "Bash(npm run release*)"
    ]
  },
  "autoCompactEnabled": true,
  "autoMemoryEnabled": true,
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  }
}
