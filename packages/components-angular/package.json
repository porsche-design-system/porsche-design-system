{
  "name": "@porsche-design-system/angular",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "scripts": {
    "start": "concurrently -k -s 'first' -n 'cdn,dummyassets,angular' 'serve-cdn' 'serve-dummyassets' 'ng serve'",
    "start-app": "concurrently -k -s 'first' -n 'cdn,dummyassets,app' 'serve-cdn' 'serve-dummyassets' 'ws --spa index.html -p 4200 -d ./dist/demo-app/browser'",
    "build": "npm run clean:build && npm run build:angular-wrapper && npm run build:subPackages",
    "build:angular-wrapper": "ng build angular-wrapper --configuration=production",
    "build:subPackages": "npm run build:subPackages:lib && npm run build:subPackages:stylesheets && npm run build:subPackages:tailwindcss && npm run build:subPackages:vanilla-extract && npm run build:subPackages:typings && npm run build:subPackages:skill",
    "build:subPackages:lib": "npx rollup -c ./projects/angular-wrapper/rollup.config.js --bundleConfigAsCjs",
    "build:subPackages:skill": "npm run build:subPackages:skill:content && npm run build:subPackages:skill:bin",
    "build:subPackages:skill:content": "SOURCE=../storefront/projects/skills/generated/angular/skills && TARGET=./dist/angular-wrapper/skills && test -f $SOURCE/pds-knowledge-angular/SKILL.md || { echo 'Missing staged angular skill. Run npm run build:skills first.' >&2; exit 1; }; rm -rf $TARGET && cp -r $SOURCE $TARGET",
    "build:subPackages:skill:bin": "SOURCE=../storefront/projects/skills/bin/pds-skill.js && TARGET=./dist/angular-wrapper/bin && test -f $SOURCE || { echo \"Missing canonical pds-skill binary at $SOURCE.\" >&2; exit 1; }; rm -rf $TARGET && mkdir -p $TARGET && cp $SOURCE $TARGET/pds-skill.js && chmod +x $TARGET/pds-skill.js",
    "build:subPackages:tailwindcss": "TARGET=./dist/angular-wrapper/tailwindcss && rm -rf $TARGET && cp -r ../styles/projects/tailwindcss/dist $TARGET",
    "build:subPackages:vanilla-extract": "TARGET=./dist/angular-wrapper/vanilla-extract && rm -rf $TARGET && cp -r ../styles/projects/vanilla-extract/dist $TARGET",
    "build:subPackages:stylesheets": "TARGET=./dist/angular-wrapper/stylesheets && SOURCE=../components/projects/stylesheets/lib && rm -rf $TARGET && mkdir -p $TARGET/cn && cp $SOURCE/*.css $TARGET/ && cp $SOURCE/cn/*.css $TARGET/cn/",
    "build:subPackages:typings": "npm run build:subPackages:typings:jsdom-polyfill && npm run build:subPackages:typings:partials && npm run build:subPackages:typings:testing && npm run build:subPackages:typings:tokens && npm run build:subPackages:typings:emotion && npm run build:subPackages:typings:vanilla-extract && npm run build:subPackages:typings:ag-grid && npm run build:subPackages:typings:meta",
    "build:subPackages:typings:jsdom-polyfill": "tsc projects/angular-wrapper/src/jsdom-polyfill/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/jsdom-polyfill --types node --ignoreConfig",
    "build:subPackages:typings:partials": "tsc projects/angular-wrapper/src/partials/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/partials/esm --types node --skipLibCheck true --ignoreConfig",
    "build:subPackages:typings:testing": "tsc projects/angular-wrapper/src/testing/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/testing --types node --ignoreConfig",
    "build:subPackages:typings:tokens": "tsc projects/angular-wrapper/src/tokens/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/tokens/esm --types node --ignoreConfig",
    "build:subPackages:typings:emotion": "tsc projects/angular-wrapper/src/emotion/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/emotion/esm --types node --ignoreConfig",
    "build:subPackages:typings:vanilla-extract": "tsc projects/angular-wrapper/src/vanilla-extract/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/vanilla-extract/esm --types node --ignoreConfig",
    "build:subPackages:typings:ag-grid": "tsc projects/angular-wrapper/src/ag-grid/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/ag-grid/esm --types node --ignoreConfig",
    "build:subPackages:typings:meta": "tsc projects/angular-wrapper/src/meta/index.ts --declaration --emitDeclarationOnly --declarationDir dist/angular-wrapper/meta/esm --types node --ignoreConfig",
    "build-app": "ng build demo-app --configuration=production && npm run build-app:injectPartials",
    "build-app:injectPartials": "tsx scripts/inject-partials.ts",
    "ng:update": "./scripts/ng-update.sh",
    "test": "npm run test:unit && npm run test:e2e && npm run test:vrt && npm run test:smoke",
    "test:unit": "npm run test:unit:vitest && npm run test:unit:karma",
    "test:unit:vitest": "vitest -c tests/unit/config/vitest.config.ts",
    "test:unit:karma": "concurrently -k -s 'first' -n 'cdn,test' 'serve-cdn' 'ng test'",
    "test:unit:karma-ci": "concurrently -k -s 'first' -n 'cdn,test' 'serve-cdn' 'ng test --browsers=ChromeHeadlessCI --watch=false'",
    "test:e2e": "npm run build-app && playwright test --config=tests/e2e/config/playwright.config.ts",
    "test:vrt": "playwright test --config=tests/vrt/config/playwright.config.ts",
    "test:smoke": "npm run test:smoke:unit",
    "test:smoke:unit": "vitest --config tests/smoke/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./dist && rm -rf ./tmp && rm -rf ./out-tsc && rm -rf ./bazel-out && rm -rf ./.angular"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@porsche-design-system/components-angular": "4.7.0-beta.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-service": "^22.1.0",
    "@playwright/test": "1.61.0",
    "@porsche-design-system/assets": "5.0.2",
    "@porsche-design-system/shared": "0.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^19.4.1",
    "@types/jasmine": "^6.0.0",
    "ag-grid-angular": "36.1.0",
    "ag-grid-community": "36.1.0",
    "ag-grid-enterprise": "36.1.0",
    "change-case": "^5.4.4",
    "concurrently": "^10.0.4",
    "istanbul-lib-instrument": "^6.0.3",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "local-web-server": "^5.4.0",
    "ng-packagr": "^22.1.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
