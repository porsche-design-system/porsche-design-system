{
  "name": "@porsche-design-system/font-face",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "homepage": "https://designsystem.porsche.com",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./scripts/fontFaceStyles": "./scripts/fontFaceStyles.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/",
    "./scripts/"
  ],
  "scripts": {
    "build": "npm run clean:build && npm run build:font-face && npm run build:lib",
    "build:font-face": "npm run typecheck && tsx scripts/buildFontFace.ts",
    "build:lib": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./index.ts && rm -rf ./dist"
  },
  "devDependencies": {
    "@porsche-design-system/fonts": "0.0.0",
    "@porsche-design-system/shared": "0.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "change-case": "^5.4.4",
    "jss": "^10.10.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "volta": {
    "extends": "../../../../package.json"
  }
}
