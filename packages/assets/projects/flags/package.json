{
  "name": "@porsche-design-system/flags",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "homepage": "https://designsystem.porsche.com",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "lint": "publint",
    "build": "npm run clean:build && npm run build:flags && npm run build:lib",
    "build:flags": "tsx scripts/build.ts",
    "build:lib": "rollup -c",
    "test:unit": "vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./index.ts && rm -rf ./dist"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "change-case": "^5.4.4",
    "fast-glob": "^3.3.3",
    "gzip-size": "^7.0.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "svgo": "^4.0.2",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../../../../package.json"
  }
}
