{
  "name": "@porsche-design-system/icons",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "homepage": "https://designsystem.porsche.com",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "npm run clean:build && npm run build:icons && npm run build:lib",
    "build:icons": "tsx scripts/build.ts",
    "build:lib": "rollup -c",
    "test:unit": "vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./index.ts && rm -rf ./dist"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0"
  },
  "peerDependencies": {
    "@rollup/plugin-typescript": "*",
    "change-case": "*",
    "fast-glob": "*",
    "gzip-size": "*",
    "prettier": "*",
    "rollup": "*",
    "rollup-plugin-dts": "*",
    "svgo": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "volta": {
    "extends": "../../../../package.json"
  }
}
