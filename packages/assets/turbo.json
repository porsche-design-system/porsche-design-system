{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["shared#build", "@porsche-design-system/tokens#build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx"],
      "outputs": ["dist/**", "cdn/**", "bin/**", "projects/*/dist/**", "projects/*/index.ts"]
    }
  }
}
