{
  "name": "@porsche-design-system/tokens-meta",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "homepage": "https://designsystem.porsche.com",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./skill": {
      "types": "./skill/skill.ts",
      "default": "./skill/skill.ts"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "npm run clean:build && npm run build:generateTokensMeta && npm run build:package",
    "build:generateTokensMeta": "tsx scripts/generateTokensMeta.ts",
    "build:package": "rollup -c rollup.config.js",
    "test": "npm run test:unit",
    "test:unit": "vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./dist && rm -rf ./src/lib"
  },
  "dependencies": {
    "@porsche-design-system/shared": "0.0.0"
  },
  "devDependencies": {
    "@porsche-design-system/tokens": "0.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "change-case": "^5.4.4",
    "rollup": "^4.62.4",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../../../../package.json"
  }
}
