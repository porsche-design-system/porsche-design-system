{
  "name": "@porsche-design-system/patterns-nunjucks",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsx scripts/build.ts && npm run build:css",
    "build:css": "tailwindcss --input ./src/assets/patterns.css --output ./dist/assets/patterns.css",
    "preview": "npm run build && vite preview --outDir ../dist --port 3009",
    "lint": "biome lint",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "clean:build": "rm -rf ./dist"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/nunjucks": "^3.2.6",
    "fast-glob": "^3.3.3",
    "nunjucks": "^3.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
