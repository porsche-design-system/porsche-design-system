{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@porsche-design-system/components#build",
        "@porsche-design-system/assets#build",
        "shared#build",
        "@porsche-design-system/stylesheets#build",
        "@porsche-design-system/component-meta#build",
        "@porsche-design-system/tokens#build",
        "@porsche-design-system/styles#build",
        "utilities-v2#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx", "!tests/**", "!projects/**/src/lib/**", "!projects/components-wrapper/lib/**"],
      "outputs": ["dist/**", "projects/*/dist/**", "projects/components-wrapper/lib/**", "projects/**/src/lib/**", "public/**"]
    },
    "build-prod": {
      "dependsOn": [
        "@porsche-design-system/components#build-prod",
        "@porsche-design-system/assets#build",
        "shared#build",
        "@porsche-design-system/stylesheets#build-prod",
        "@porsche-design-system/component-meta#build",
        "@porsche-design-system/tokens#build",
        "@porsche-design-system/styles#build-prod",
        "utilities-v2#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx", "!tests/**", "!projects/**/src/lib/**", "!projects/components-wrapper/lib/**"],
      "outputs": ["dist/**", "projects/*/dist/**", "projects/components-wrapper/lib/**", "projects/**/src/lib/**", "public/**"]
    }
  }
}
