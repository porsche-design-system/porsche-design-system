{
  "name": "@porsche-design-system/testing",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./assert-defined": {
      "types": "./src/assertDefined.ts",
      "default": "./src/assertDefined.ts"
    },
    "./normalize-css-namespace": {
      "types": "./src/normalizeCssNamespace.ts",
      "default": "./src/normalizeCssNamespace.ts"
    },
    "./playwright": {
      "types": "./src/playwright/index.ts",
      "default": "./src/playwright/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "npm run typecheck:tests && vitest --config tests/unit/config/vitest.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@porsche-design-system/shared": "0.0.0",
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@playwright/test": "1.63.0"
  },
  "volta": {
    "extends": "../../../../package.json"
  }
}
