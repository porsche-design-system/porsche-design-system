{
  "extends": "./src/tsconfig.json",
  "compilerOptions": {
    "strict": false, // 🙈 too many issues
    "verbatimModuleSyntax": false,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
  },
  "include": ["./src", "./scripts"],
  "exclude": ["**/*.spec.ts", "src/examples"] // generated, imports the framework wrappers built later; the gated bundler cannot resolve them
}
