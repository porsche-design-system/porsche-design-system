{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@porsche-design-system/react#build",
        "@porsche-design-system/component-meta#build",
        "@porsche-design-system/stylesheets#build",
        "@porsche-design-system/styles#build",
        "@porsche-design-system/tokens#build",
        "shared#build"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "projects/stackblitz/dist/**"]
    },
    "build-prod": {
      "dependsOn": [
        "@porsche-design-system/react#build-prod",
        "@porsche-design-system/component-meta#build",
        "@porsche-design-system/stylesheets#build-prod",
        "@porsche-design-system/styles#build-prod",
        "@porsche-design-system/tokens#build",
        "shared#build"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "projects/stackblitz/dist/**"]
    }
  }
}
