{
  "name": "@porsche-design-system/storefront",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "scripts": {
    "dev": "npm run prebuild && concurrently -k -s 'first' -n 'cdn,next' 'serve-cdn' 'next dev'",
    "prebuild": "npm run build:stackblitz && npm run build:generateTableOfContents && npm run build:preparePartialResults && npm run build:prepareChangelog && npm run build:copyLicense",
    "build": "next build",
    "build-prod": "npm run build",
    "build:stackblitz": "npm run build --workspace=@porsche-design-system/stackblitz",
    "build:generateTableOfContents": "tsx --tsconfig tsconfig.node.json scripts/generateTableOfContents.ts",
    "build:preparePartialResults": "tsx --tsconfig tsconfig.node.json scripts/preparePartialResults.ts",
    "build:prepareChangelog": "tsx --tsconfig tsconfig.node.json scripts/prepareChangelog.ts",
    "build:copyLicense": "cp ../../LICENSE.md './src/app/(main)/license/license.mdx'",
    "start-app": "concurrently -k -s 'first' -n 'cdn,app' 'serve-cdn' 'ws -p 8080 -d ./dist'",
    "updateAlgolia": "tsx --tsconfig tsconfig.json scripts/updateAlgoliaIndex.tsx",
    "lint": "biome lint",
    "test": "npm run test:unit",
    "test:unit": "NEXT_PUBLIC_PDS_ENV=development npm run build && vitest --config tests/unit/config/vitest.config.ts",
    "test:e2e": "NEXT_PUBLIC_PDS_ENV=development npm run build && playwright test --config=tests/e2e/config/playwright.config.ts",
    "test:e2e:1/4": "npm run test:e2e -- --shard=1/4 --grep-invert 'sitemap.json'",
    "test:e2e:2/4": "npm run test:e2e -- --shard=2/4 --grep-invert 'sitemap.json'",
    "test:e2e:3/4": "npm run test:e2e -- --shard=3/4 --grep-invert 'sitemap.json'",
    "test:e2e:4/4": "npm run test:e2e -- --shard=4/4 --grep-invert 'sitemap.json'",
    "test:e2e:sitemap": "npm run test:e2e -- --grep 'sitemap.json'",
    "test:a11y": "NEXT_PUBLIC_PDS_ENV=development npm run build && playwright test --config=tests/a11y/config/playwright.config.ts",
    "test:a11y:1/6": "npm run test:a11y -- --shard=1/6",
    "test:a11y:2/6": "npm run test:a11y -- --shard=2/6",
    "test:a11y:3/6": "npm run test:a11y -- --shard=3/6",
    "test:a11y:4/6": "npm run test:a11y -- --shard=4/6",
    "test:a11y:5/6": "npm run test:a11y -- --shard=5/6",
    "test:a11y:6/6": "npm run test:a11y -- --shard=6/6",
    "test:vrt": "NEXT_PUBLIC_PDS_ENV=development npm run build && playwright test --config=tests/vrt/config/playwright.config.ts",
    "test:vrt:prepare-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/results --mode prepare",
    "test:vrt:update-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/specs/__screenshots__ --mode update",
    "clean:build": "rm -rf ./dist && rm -rf ./.next && npm run clean:stackblitz:build",
    "clean:stackblitz:build": "npm run clean:build --workspace=@porsche-design-system/stackblitz"
  },
  "dependencies": {
    "@algolia/cache-in-memory": "^4.26.0",
    "@porsche-design-system/components-react": "4.2.0-rc.5",
    "algoliasearch": "^5.55.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-instantsearch": "^7.35.1",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@porsche-design-system/shared": "0.0.0",
    "@porsche-design-system/stackblitz": "0.0.0",
    "@porsche-design-system/stylesheets": "0.0.0",
    "@porsche-design-system/tailwindcss": "0.0.0",
    "@porsche-design-system/tokens-meta": "0.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "cheerio": "^1.2.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@axe-core/playwright": "*",
    "@playwright/test": "*",
    "@tailwindcss/postcss": "*",
    "change-case": "*",
    "concurrently": "*",
    "fast-glob": "*",
    "local-web-server": "*",
    "postcss": "*",
    "react": "*",
    "react-dom": "*",
    "tailwindcss": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.2.9",
    "@next/swc-darwin-x64": "^16.2.9",
    "@next/swc-linux-arm64-gnu": "^16.2.9",
    "@next/swc-linux-arm64-musl": "^16.2.9",
    "@next/swc-linux-x64-gnu": "^16.2.9",
    "@next/swc-linux-x64-musl": "^16.2.9",
    "@next/swc-win32-arm64-msvc": "^16.2.9",
    "@next/swc-win32-x64-msvc": "^16.2.9"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
