          // Alternative: With multiple prefixes to match prefixed components coming from micro frontends
          fontLinks: require('@porsche-design-system/components-vue/partials').getFontLinks({ prefix: ['', 'custom-prefix', 'another-prefix'] }),
        },
      },
    }),
  ],
})"
`;
