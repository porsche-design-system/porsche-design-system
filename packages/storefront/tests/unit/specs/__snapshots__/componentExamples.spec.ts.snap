exports[`component examples generator > emits files and a reference table for p-button (angular) > table 1`] = `
"## Examples

| Example | When to use | File |
| --- | --- | --- |
| Default | Minimal default configuration. | [./examples/Default.ts](./examples/Default.ts) |
| Loading | Use a loading state while an async action is in progress. | [./examples/Loading.ts](./examples/Loading.ts) |
| Submit form | Submit the surrounding form when the button is activated. | [./examples/SubmitForm.ts](./examples/SubmitForm.ts) |
| Form association | Associate the button with a form by its \`id\` using the \`form\` attribute. | — |"
`;

