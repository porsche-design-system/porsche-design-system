  "            "effortRationale"",
  "          ]",
  "        }",
  "      }",
  "    },",
  "    "manualFollowUps": {",
  "      "type": "array",",
  "      "items": {",
  "        "type": "object",",
  "        "additionalProperties": false,",
  "        "required": [",
  "          "subject",",
  "          "reason",",
