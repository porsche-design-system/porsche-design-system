  "  <PIcon name="wrenches" :aria="{'aria-label': 'Wrenches icon'}"></PIcon>",
  "",
  "  <PIcon name="zoom-in" :aria="{'aria-label': 'Zoom In icon'}"></PIcon>",
  "",
