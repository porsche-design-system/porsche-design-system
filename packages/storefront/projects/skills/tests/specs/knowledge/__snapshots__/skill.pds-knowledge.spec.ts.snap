  "\`\`\`html",
  "<PTextList type="unordered">",
  "  <PTextListItem>",
  "    Sport Chrono Package",
  "  </PTextListItem>",
  "  <PTextListItem>",
  "    BOSE Surround Sound",
  "  </PTextListItem>",
  "</PTextList>",
  "\`\`\`",
  "",
]
