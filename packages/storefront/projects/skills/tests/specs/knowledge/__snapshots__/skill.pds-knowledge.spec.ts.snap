  "      Tab One",
  "    </button>",
  "    <button type="button">",
  "      Tab Two",
  "    </button>",
  "    <button type="button">",
  "      Tab Three",
  "    </button>",
  "  </PTabsBar>",
  "</template>",
  "",
]
`;

