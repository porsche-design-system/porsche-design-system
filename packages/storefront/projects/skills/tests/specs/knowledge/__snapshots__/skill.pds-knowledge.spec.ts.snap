exports[`pds-knowledge skill tree content > matches the staged react content snapshots > references/components/p-table/examples/Default.tsx 1`] = `
[
  "import React from 'react';",
  "import { PTable, PTableBody, PTableCell, PTableHead, PTableHeadCell, PTableHeadRow, PTableRow } from '@porsche-design-system/components-react';",
  "",
  "export const Example = () => {",
  "  return (",
  "    <>",
  "      <PTable caption="Some caption">",
  "        <PTableHead>",
  "          <PTableHeadRow>",
  "            <PTableHeadCell>",
  "              Model",
  "            </PTableHeadCell>",
  "            <PTableHeadCell>",
  "              Date",
  "            </PTableHeadCell>",
  "            <PTableHeadCell>",
