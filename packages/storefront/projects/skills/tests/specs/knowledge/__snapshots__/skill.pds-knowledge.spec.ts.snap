exports[`pds-knowledge skill tree content > matches the staged js content snapshots > references/components/p-icon/examples/ColorCssVar.html 1`] = `
[
  "<!doctype html>",
  "<html lang="en" class="scheme-light">",
  "<head>",
  "  <title></title>",
  "</head>",
  "<body class="bg-canvas">",
