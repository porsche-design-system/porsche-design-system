[
  "# p-divider accessibility integration examples",
  "",
  "## Integration examples",
  "",
  "### Divider as the only section separator",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`tsx",
  "<PText>",
  "  Delivery details",
  "</PText>",
  "",
  "<PDivider></PDivider>",
  "",
  "<PText>",
  "  Payment details",
  "</PText>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`tsx",
  "<PHeading tag="h2" size="md">",
  "  Delivery details",
  "</PHeading>",
  "",
  "<PText>",
  "  ...",
  "</PText>",
  "",
  "<PDivider></PDivider>",
  "",
  "<PHeading tag="h2" size="md">",
  "  Payment details",
  "</PHeading>",
  "",
  "<PText>",
  "  ...",
  "</PText>",
  "\`\`\`",
  "",
]
`;

