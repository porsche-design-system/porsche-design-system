[
  "# p-tag accessibility integration examples",
  "",
  "## Integration examples",
  "",
  "### Status conveyed by color and icon only",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`html",
  "<PTag variant="success" icon="check"></PTag>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`html",
  "<PTag variant="success" icon="check">",
  "  Configuration saved",
  "</PTag>",
  "\`\`\`",
  "",
]
`;

