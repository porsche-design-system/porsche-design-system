  "    setOpen(true);",
  "  }",
  "  const onUpdate = (e: CustomEvent<DrilldownUpdateEventDetail>) => {",
  "    setActiveIdentifier(e.detail.activeIdentifier);",
  "  }",
  "  const onDismiss = () => {",
  "    setOpen(false);",
  "  }",
