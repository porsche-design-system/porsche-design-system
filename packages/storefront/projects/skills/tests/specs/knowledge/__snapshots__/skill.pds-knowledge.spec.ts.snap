exports[`pds-knowledge skill tree content > matches the staged vue content snapshots > references/components/p-divider/p-divider.md 1`] = `
[
  "# p-divider",
  "",
  "The \`p-divider\` is used as 'horizontal or vertical rule' and displays a dividing line. The component is self-closing. Slotted content between the component tags won't be displayed.",
  "",
  "## Usage",
  "",
  "### Do:",
  "",
  "- Use to create a visual separation between related sections of content.",
  "- Use to separate content into clear groups.",
  "- Use when other options for structuring content are not sufficient.",
  "",
  "### Don't:",
  "",
  "- Don't use dividers to structure content, rather work with more space for clustering",
  "- Don't use it for decorative purposes unless it's necessary.",
  "- Avoid full-bleed dividers to separate page sections.",
  "",
  "## Accessibility support",
  "",
  "This component does not include any special accessibility features.",
  "",
  "## Development considerations",
  "",
  "### Structure",
  "",
  "A divider is visual separation only. Use headings, landmarks, or section structure to communicate content groups.",
  "",
  "### Common do's and don'ts",
  "",
  "- **Do** pair dividers with headings or landmarks that describe the sections they separate.",
  "- **Don't** rely on a divider alone to communicate a new major section.",
  "",
  "## Integration examples",
  "",
  "See [accessibility integration examples](./accessibility.md) for paired anti-pattern and recommended implementations.",
  "",
  "## API",
  "",
  "### Properties",
  "",
  "| Property | Type | Default | Description |",
  "| --- | --- | --- | --- |",
  "| \`color\` | \`'contrast-lower'\` \`'contrast-low'\` \`'contrast-medium'\` \`'contrast-high'\` | \`'contrast-lower'\` | Sets the color of the divider line using PDS contrast tokens. |",
  "| \`direction\` | \`'vertical'\` \`'horizontal'\`<br>\`BreakpointCustomizable<DividerDirection>\` | \`'horizontal'\` | Sets the orientation of the divider to \`horizontal\` or \`vertical\`. Supports responsive breakpoint values. |",
  "",
  "## Examples",
  "",
  "| Example | When to use | File |",
  "| --- | --- | --- |",
  "| Default | Minimal default configuration. | [./examples/Default.vue](./examples/Default.vue) |",
  "| Vertical | **Hint:** The component has not an implicit vertical height unless we set a container which provides it or define the height on the component itself. | [./examples/Vertical.vue](./examples/Vertical.vue) |",
  "| Responsive | You can change the divider's direction by using different major breakpoints \`xs\`, \`s\`, \`m\`, \`l\`, \`xl\`. | [./examples/Responsive.vue](./examples/Responsive.vue) |",
  "",
]
`;

exports[`pds-knowledge skill tree content > matches the staged vue content snapshots > references/components/p-drilldown/accessibility.md 1`] = `
[
  "# p-drilldown accessibility integration examples",
  "",
  "## Integration examples",
  "",
  "### ARIA on trigger button host vs aria prop",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`html",
  "<PButton aria-haspopup="dialog">",
  "  Menu",
  "</PButton>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`html",
  "<PButton :aria="{'aria-haspopup': 'dialog'}">",
  "  Vehicle menu",
  "</PButton>",
  "\`\`\`",
  "",
  "### Drilldown label on component host vs aria prop",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`html",
  "<PDrilldown :open="true" aria-label="Navigation">",
  "  ...",
  "</PDrilldown>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`html",
  "<PDrilldown :open="true" :aria="{'aria-label': 'Vehicle navigation'}">",
  "  ...",
  "</PDrilldown>",
  "\`\`\`",
  "",
  "### Trigger without popup semantics or context",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`html",
  "<PButton>",
  "  Menu",
  "</PButton>",
  "",
  "<PDrilldown>",
  "  ...",
  "</PDrilldown>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`html",
  "<PButton :aria="{'aria-haspopup': 'dialog'}">",
  "  Vehicle menu",
  "</PButton>",
  "",
  "<PDrilldown :aria="{'aria-label': 'Vehicle navigation'}">",
  "  ...",
  "</PDrilldown>",
  "\`\`\`",
  "",
]
`;

exports[`pds-knowledge skill tree content > matches the staged vue content snapshots > references/components/p-drilldown/examples/CustomContent.vue 1`] = `
[
  "<script setup lang="ts">",
  "  import { ref } from 'vue';",
  "  import { PButton, PButtonTile, PDrilldown, PDrilldownItem, PDrilldownLink, PLink, PModelSignature, type DrilldownUpdateEventDetail } from '@porsche-design-system/components-vue';",
  "",
  "  const activeIdentifier = ref("id-1");",
  "  const open = ref(false);",
  "",
  "  const onClick = () => {",
  "    open.value = true;",
  "  }",
  "  const onUpdate = (e: CustomEvent<DrilldownUpdateEventDetail>) => {",
  "    activeIdentifier.value = e.detail.activeIdentifier;",
  "  }",
  "  const onDismiss = () => {",
  "    open.value = false;",
  "  }",
  "</script>",
  "",
  "<template>",
  "  <nav aria-label="Main">",
  "    <PButton type="button" :aria="{'aria-haspopup': 'dialog'}" @click="onClick">",
  "      Open Drilldown",
  "    </PButton>",
  "    <PDrilldown :open="open" :activeIdentifier="activeIdentifier" class="[--p-drilldown-grid-template:repeat(5,auto)_minmax(0,1fr)/auto]" @update="onUpdate" @dismiss="onDismiss">",
  "      <PDrilldownItem identifier="id-1" label="Motorsport" class="[--p-drilldown-grid-template:auto/repeat(2,minmax(0,1fr))] [--p-drilldown-gap:0px_16px]">",
  "        <PDrilldownItem identifier="id-1-1" label="718">",
  "          <PModelSignature slot="header" model="718"></PModelSignature>",
  "          <PButtonTile slot="button" label="Some label" description="718" weight="semi-bold" :compact="true" :aspectRatio="{'base': '1/1', 's': '9/16'}" class="mb-fluid-sm">",
  "            <img srcSet="assets/porsche-963@2x.webp 2x" src="assets/porsche-963.webp" :width="636" :height="847" alt="Porsche 963" />",
  "          </PButtonTile>",
  "          <PDrilldownLink href="#">",
