[
  "# p-button-tile accessibility integration examples",
  "",
  "## Integration examples",
  "",
  "### ARIA on component host vs aria prop",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`tsx",
  "<PButtonTile label="Open" aria-label="Open details of Porsche Taycan" aria-haspopup="dialog"></PButtonTile>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`tsx",
  "<PButtonTile label="Open" aria={{'aria-haspopup': 'dialog', 'aria-label': 'Open details of Porsche Taycan'}}></PButtonTile>",
  "\`\`\`",
  "",
  "### Vague tile label without context",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`tsx",
  "<PButtonTile label="Open"></PButtonTile>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`tsx",
  "<PButtonTile label="Configure Porsche Taycan"></PButtonTile>",
  "\`\`\`",
  "",
]
`;

