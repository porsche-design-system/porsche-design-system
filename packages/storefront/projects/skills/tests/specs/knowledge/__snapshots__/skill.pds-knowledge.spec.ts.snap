[
  "# p-text-list accessibility integration examples",
  "",
  "## Integration examples",
  "",
  "### Numbered list for non-sequential items",
  "",
  "#### ❌ Anti-pattern",
  "",
  "\`\`\`tsx",
  "<PTextList type="numbered">",
  "  <PTextListItem>",
  "    Sport Chrono Package",
  "  </PTextListItem>",
  "  <PTextListItem>",
  "    BOSE Surround Sound",
  "  </PTextListItem>",
  "</PTextList>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`tsx",
  "<PTextList type="unordered">",
  "  <PTextListItem>",
  "    Sport Chrono Package",
  "  </PTextListItem>",
  "  <PTextListItem>",
  "    BOSE Surround Sound",
  "  </PTextListItem>",
  "</PTextList>",
  "\`\`\`",
  "",
]
