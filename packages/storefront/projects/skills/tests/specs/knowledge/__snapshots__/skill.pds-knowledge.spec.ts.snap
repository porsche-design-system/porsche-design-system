  "        Cell 1",
  "      </p-table-cell>",
  "      <p-table-cell>",
  "        Cell 2",
  "      </p-table-cell>",
  "      <p-table-cell>",
  "        Cell 3",
  "      </p-table-cell>",
  "    </p-table-row>",
  "  </p-table-body>",
  "</p-table>",
  "<script>",
  "",
  "</script>",
  "</body>",
  "</html>",
  "",
]
`;

