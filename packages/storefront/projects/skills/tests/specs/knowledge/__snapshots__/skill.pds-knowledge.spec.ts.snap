  "        link",
  "      </a>",
  "      .",
  "    </PPopover>",
  "    <span slot="description" id="some-description-id">",
  "      Some description with a ",
  "      <a href="https://designsystem.porsche.com" class="underline">",
  "        link",
  "      </a>",
  "      .",
