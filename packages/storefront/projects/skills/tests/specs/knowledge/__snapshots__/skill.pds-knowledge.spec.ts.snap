  "<p-tag variant="success" icon="check"></p-tag>",
  "\`\`\`",
  "",
  "#### ✅ Recommended",
  "",
  "\`\`\`html",
  "<p-tag variant="success" icon="check">",
  "  Configuration saved",
  "</p-tag>",
  "\`\`\`",
  "",
]
`;

