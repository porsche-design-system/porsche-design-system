exports[`pds-knowledge skill tree content > matches the staged js content snapshots > references/components/p-carousel/examples/FocusOnCenterSlide.html 1`] = `
[
  "<style>",
  "  p-carousel {",
  "    --p-gradient-color-width: 25%;",
  "  }",
  "",
  "  p-carousel div {",
  "    display: flex;",
  "    align-items: center;",
  "    justify-content: center;",
  "    background: #00b0f4;",
  "    height: 150px;",
  "    transition: background 0.3s ease;",
  "  }",
  "",
