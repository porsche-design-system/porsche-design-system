exports[`pds-knowledge skill tree content > matches the staged js content snapshots > references/components/p-model-signature/examples/MaskVideo.html 1`] = `
[
  "<!doctype html>",
  "<html lang="en" class="scheme-light">",
  "<head>",
  "  <title></title>",
  "</head>",
  "<body class="bg-canvas">",
  "",
  "<p-model-signature safe-zone="false" class="[--p-model-signature-width:auto]">",
  "  <video poster="assets/ocean.jpg" src="assets/ocean.mp4" autoplay playsinline loop muted></video>",
  "</p-model-signature>",
  "<script>",
  "",
  "</script>",
  "</body>",
  "</html>",
  "",
]
`;

