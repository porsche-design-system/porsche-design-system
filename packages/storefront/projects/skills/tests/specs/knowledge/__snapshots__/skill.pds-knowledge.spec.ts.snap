exports[`pds-knowledge skill tree content > matches the staged vue content snapshots > references/components/p-input-date/examples/Form.vue 1`] = `
[
  "<template>",
  "  <form @submit.prevent="onSubmit" @reset.prevent="onReset" class="flex flex-col gap-fluid-sm">",
  "    <PInputDate",
  "      v-model:value="form.myInputDate"",
  "      :name="'myInputDate'"",
  "      :label="'Some Label'"",
  "    />",
  "    <div class="flex gap-fluid-sm">",
  "      <PButton type="submit">Submit</PButton>",
  "      <PButton type="reset">Reset</PButton>",
  "    </div>",
  "    <PText>Last submitted data: {{ submittedValue }}</PText>",
  "  </form>",
  "</template>",
  "",
  "<script setup lang="ts">",
  "import { PButton, PInputDate, PText } from '@porsche-design-system/components-vue';",
  "import { reactive, ref } from 'vue';",
  "",
  "const form = reactive({",
  "  myInputDate: '',",
  "});",
  "",
  "const submittedValue = ref();",
  "",
  "const onSubmit = () => {",
  "  submittedValue.value = JSON.stringify(form);",
  "};",
  "",
  "const onReset = () => {",
  "  form.myInputDate = '';",
  "};",
  "</script>",
  "",
]
`;

