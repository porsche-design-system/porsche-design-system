{
  "name": "@porsche-design-system/story-generator",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint",
    "test": "npm run test:unit",
    "test:unit": "npm run typecheck:tests && vitest --config tests/unit/config/vitest.config.ts"
  },
  "dependencies": {
    "change-case": "^5.4.4"
  },
  "peerDependencies": {
    "@porsche-design-system/components-react": "4.9.0-rc.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@porsche-design-system/components-react": "4.9.0-rc.0",
    "@porsche-design-system/shared": "0.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
