{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true
  },
  "include": ["plugins/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
