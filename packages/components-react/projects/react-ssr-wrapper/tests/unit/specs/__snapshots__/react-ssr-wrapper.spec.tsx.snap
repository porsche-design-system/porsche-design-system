<p-spinner
  data-ssr=""
>
  <template
    shadowroot="open"
    shadowrootmode="open"
  >
    <style>
      @keyframes rotate {
  0% {
    transform: rotateZ(0deg);
  }
  100% {
    transform: rotateZ(360deg);
  }
}
@keyframes dash {
  0% {
    stroke-dashoffset: 69;
    transform: rotateZ(0);
  }
  50%, 75% {
    stroke-dashoffset: 24;
    transform: rotateZ(80deg);
  }
  100% {
    stroke-dashoffset: 69;
    transform: rotateZ(360deg);
  }
}
  :host {
    display: inline-flex;
    vertical-align: top;
  }
  :host([hidden]) {
    display: none !important;
  }
  div {
