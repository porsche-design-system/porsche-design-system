}
.sidebar__header--start::before {
  background: linear-gradient(180deg,var(--p-color-surface) 0%,var(--p-color-surface) 65%,transparent 100%);
}
.sidebar__header--end {
  justify-content: space-between;
}
.sidebar__header--end::before {
  background: linear-gradient(180deg,var(--p-color-canvas) 0%,var(--p-color-canvas) 65%,transparent 100%);
}
.sidebar__header::before {
