  min-height: var(--p-leading-normal);
  cursor: pointer;
}
.label-wrapper {
  min-width: fit-content;
  position: static;
  width: auto;
  height: auto;
  padding: 0;
  margin: 0;
  overflow: visible;
  clip: auto;
  white-space: normal;
  padding-top: max(0px, calc((calc(var(--_p-checkbox-scaling) * 1.75rem) - var(--p-leading-normal)) / 2));
  padding-inline-start: calc(11.2px * (var(--_p-checkbox-scaling) - 0.64285714) + 4px);
}
.label {
