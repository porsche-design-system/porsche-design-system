{
  "name": "@porsche-design-system/nextjs",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "scripts": {
    "prestartAndBuild": "npm run clean:build && tsx scripts/prepareSharedStyles.ts",
    "prestart": "npm run prestartAndBuild",
    "prebuild-app": "npm run prestartAndBuild",
    "start": "concurrently -k -s 'first' -n 'cdn,dummyassets,nextjs' 'serve-cdn' 'serve-dummyassets' 'next dev'",
    "start-app": "concurrently -k -s 'first' -n 'cdn,dummyassets,app' 'serve-cdn' 'serve-dummyassets' 'next start'",
    "build": "npm run build-app",
    "build-app": "next build",
    "test": "npm run test:e2e && npm run test:vrt",
    "test:e2e": "playwright test --config=tests/e2e/config/playwright.config.ts",
    "test:vrt": "playwright test --config=tests/vrt/config/playwright.config.ts",
    "test:vrt:prepare-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/results --mode prepare",
    "test:vrt:update-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/specs/__screenshots__ --mode update",
    "clean:build": "rm -rf ./.next"
  },
  "dependencies": {
    "@porsche-design-system/assets": "5.0.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ag-grid-enterprise": "36.1.0",
    "ag-grid-react": "36.1.0",
    "concurrently": "^10.0.4",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.3.0",
    "@next/swc-darwin-x64": "^16.3.0",
    "@next/swc-linux-arm64-gnu": "^16.3.0",
    "@next/swc-linux-arm64-musl": "^16.3.0",
    "@next/swc-linux-x64-gnu": "^16.3.0",
    "@next/swc-linux-x64-musl": "^16.3.0",
    "@next/swc-win32-arm64-msvc": "^16.3.0",
    "@next/swc-win32-x64-msvc": "^16.3.0"
  },
  "volta": {
    "extends": "../../../../package.json"
  }
}
