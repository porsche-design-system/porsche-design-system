{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@porsche-design-system/js#build",
        "@porsche-design-system/assets#build",
        "shared#build",
        "@porsche-design-system/components#build",
        "@porsche-design-system/styles#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx", "!tests/**", "!projects/react-wrapper/src/lib/**", "!projects/react-ssr-wrapper/src/lib/**", "!projects/react-ssr-wrapper/src/BaseProps.ts", "!projects/react-ssr-wrapper/src/hooks.ts", "!projects/react-ssr-wrapper/src/provider.tsx", "!projects/react-ssr-wrapper/src/public-api.ts", "!projects/react-ssr-wrapper/src/utils.ts", "!projects/nextjs/app/*/**", "!projects/nextjs/styles/getSharedStyles.tsx", "!src/pages/generated/**"],
      "outputs": [
        "dist/**",
        "projects/*/dist/**",
        "projects/nextjs/.next/**",
        "!projects/nextjs/.next/cache/**",
        "projects/react-router/build/**",
        "projects/react-wrapper/src/lib/**",
        "projects/react-ssr-wrapper/src/lib/**",
        "projects/react-ssr-wrapper/src/BaseProps.ts",
        "projects/react-ssr-wrapper/src/hooks.ts",
        "projects/react-ssr-wrapper/src/provider.tsx",
        "projects/react-ssr-wrapper/src/public-api.ts",
        "projects/react-ssr-wrapper/src/utils.ts",
        "projects/nextjs/app/*/**",
        "projects/nextjs/styles/getSharedStyles.tsx",
        "src/pages/generated/**"
      ]
    },
    "build-prod": {
      "dependsOn": [
        "@porsche-design-system/js#build-prod",
        "@porsche-design-system/assets#build",
        "shared#build",
        "@porsche-design-system/components#build-prod",
        "@porsche-design-system/styles#build-prod"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx", "!tests/**", "!projects/react-wrapper/src/lib/**", "!projects/react-ssr-wrapper/src/lib/**", "!projects/react-ssr-wrapper/src/BaseProps.ts", "!projects/react-ssr-wrapper/src/hooks.ts", "!projects/react-ssr-wrapper/src/provider.tsx", "!projects/react-ssr-wrapper/src/public-api.ts", "!projects/react-ssr-wrapper/src/utils.ts", "!projects/nextjs/app/*/**", "!projects/nextjs/styles/getSharedStyles.tsx", "!src/pages/generated/**"],
      "outputs": [
        "dist/**",
        "projects/*/dist/**",
        "projects/nextjs/.next/**",
        "!projects/nextjs/.next/cache/**",
        "projects/react-router/build/**",
        "projects/react-wrapper/src/lib/**",
        "projects/react-ssr-wrapper/src/lib/**",
        "projects/react-ssr-wrapper/src/BaseProps.ts",
        "projects/react-ssr-wrapper/src/hooks.ts",
        "projects/react-ssr-wrapper/src/provider.tsx",
        "projects/react-ssr-wrapper/src/public-api.ts",
        "projects/react-ssr-wrapper/src/utils.ts",
        "projects/nextjs/app/*/**",
        "projects/nextjs/styles/getSharedStyles.tsx",
        "src/pages/generated/**"
      ]
    }
  }
}
