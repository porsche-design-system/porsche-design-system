{
  "name": "@porsche-design-system/styles",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "homepage": "https://designsystem.porsche.com",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run clean:build && npm run build:stylesheets && npm run build:tailwindcss && npm run build:scss && npm run build:emotion && npm run build:vanilla-extract && npm run build:app",
    "build-app": "tsc -b && vite build",
    "build-prod": "npm run clean:build && npm run build-prod:stylesheets && npm run build:tailwindcss && npm run build:scss && npm run build:emotion && npm run build:vanilla-extract && npm run build:app",
    "build:app": "vite build",
    "build:stylesheets": "npm run build --workspace=@porsche-design-system/stylesheets",
    "build:tailwindcss": "npm run build --workspace=@porsche-design-system/tailwindcss",
    "build:scss": "npm run build --workspace=@porsche-design-system/scss",
    "build:emotion": "npm run build --workspace=@porsche-design-system/emotion",
    "build:vanilla-extract": "npm run build --workspace=@porsche-design-system/vanilla-extract",
    "build-prod:stylesheets": "npm run build-prod --workspace=@porsche-design-system/stylesheets",
    "test": "npm run test:unit && npm run test:vrt",
    "test:unit": "npm run test:unit:stylesheets && npm run test:unit:tailwindcss && npm run test:unit:scss && npm run test:unit:emotion && npm run test:unit:vanilla-extract",
    "test:unit:stylesheets": "npm run test:unit --workspace=@porsche-design-system/stylesheets",
    "test:unit:tailwindcss": "npm run test:unit --workspace=@porsche-design-system/tailwindcss",
    "test:unit:scss": "npm run test:unit --workspace=@porsche-design-system/scss",
    "test:unit:emotion": "npm run test:unit --workspace=@porsche-design-system/emotion",
    "test:unit:vanilla-extract": "npm run test:unit --workspace=@porsche-design-system/vanilla-extract",
    "test:vrt": "playwright test --config=tests/vrt/config/playwright.config.ts",
    "clean:build": "npm run clean:build:app && npm run clean:build:stylesheets && npm run clean:build:tailwindcss && npm run clean:build:scss && npm run clean:build:emotion && npm run clean:build:vanilla-extract",
    "clean:build:app": "rm -rf ./dist",
    "clean:build:stylesheets": "npm run clean:build --workspace=@porsche-design-system/stylesheets",
    "clean:build:tailwindcss": "npm run clean:build --workspace=@porsche-design-system/tailwindcss",
    "clean:build:scss": "npm run clean:build --workspace=@porsche-design-system/scss",
    "clean:build:emotion": "npm run clean:build --workspace=@porsche-design-system/emotion",
    "clean:build:vanilla-extract": "npm run clean:build --workspace=@porsche-design-system/vanilla-extract"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0"
  },
  "peerDependencies": {
    "@playwright/test": "*",
    "typescript": "*",
    "tailwindcss": "*",
    "@tailwindcss/vite": "*",
    "vite": "*",
    "react": "*",
    "react-dom": "*",
    "react-router": "*",
    "sass": "*",
    "@vanilla-extract/css": "*",
    "@vanilla-extract/vite-plugin": "*",
    "@emotion/styled": "*"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
