exports[`should contain correct scss content for file ./dist/_display.scss 1`] = `
"@use "heading";

// @deprecated Use prose-heading-5xl() instead. This API will be removed with the next major release.
@mixin pds-display-large {
  @include heading.prose-heading-5xl;
}
// @deprecated Use prose-heading-4xl() instead. This API will be removed with the next major release.
@mixin pds-display-medium {
  @include heading.prose-heading-4xl;
}
// @deprecated Use prose-heading-3xl() instead. This API will be removed with the next major release.
@mixin pds-display-small {
  @include heading.prose-heading-3xl;
}
"
`;

exports[`should contain correct scss content for file ./dist/_focus.scss 1`] = `
"@use "border";
@use "color";
@use "sass:map";

$pds-focus-offset-map: (
  "small": 2px,
  "none": 0,
);

$pds-focus-border-radius-map: (
  "small": border.$radius-sm,
  "medium": border.$radius-md,
);

@mixin focus-visible($offset: 2px) {
  &:focus-visible {
    outline: 2px solid color.$color-focus;
    outline-offset: $offset;
  }
}
// @deprecated Use focus-visible() instead. This API will be removed with the next major release.
@mixin pds-focus($offset: "small", $border-radius: "small") {
  // it can easily be overwritten on purpose (when placed here) and visually reflected
  @if map.has-key($pds-focus-border-radius-map, $border-radius) {
    border-radius: map.get($pds-focus-border-radius-map, $border-radius);
  } @else {
    @if ($border-radius) {
      border-radius: $border-radius;
    } @else {
      border-radius: map.get($pds-focus-border-radius-map, "none");
    }
  }
  &:focus {
    outline: border.$pds-border-width-base solid color.$color-focus;
    @if map.has-key($pds-focus-offset-map, $offset) {
      outline-offset: map.get($pds-focus-offset-map, $offset);
    } @else {
      @if ($offset) {
        outline-offset: $offset;
      } @else {
        outline-offset: map.get($pds-focus-offset-map, "small");
      }
    }
  }
  // why? have a look at this article https://developer.paciellogroup.com/blog/2018/03/focus-visible-and-backwards-compatibility/
  &:focus:not(:focus-visible) {
    outline-color: transparent;
  }
}
"
`;

