@mixin color-scheme() {
  .scheme-normal {
    color-scheme: normal;
  }
  .scheme-dark {
    color-scheme: dark;
  }
  .scheme-light {
    color-scheme: light;
  }
  .scheme-light-dark {
    color-scheme: light dark;
  }
  .scheme-only-dark {
    color-scheme: only dark;
  }
  .scheme-only-light {
    color-scheme: only light;
  }

  @supports not (color: light-dark(white, black)) {
    :root,
    .scheme-light,
    .scheme-only-light,
    .scheme-normal,
    .scheme-light-dark {
      --_color-focus: #1a44ea;
      --_color-canvas: #fff;
      --_color-surface: hsl(240 10% 95%);
      --_color-frosted: hsl(240 5% 70% / 0.148);
      --_color-frosted-soft: hsl(234 9.8% 60% / 0.06);
      --_color-frosted-strong: hsl(236 6.5% 42% / 0.236);
      --_color-backdrop: hsl(240 5.3% 14.9% / 0.5);
      --_color-contrast-lower: hsl(234 6% 32.9% / 0.324);
      --_color-contrast-low: hsl(240 5.3% 14.9% / 0.5);
      --_color-contrast-medium: hsl(240 6.1% 7% / 0.6);
      --_color-contrast-high: hsl(240 7.1% 11% / 0.7);
      --_color-contrast-higher: hsl(240 8.7% 9% / 0.8);
      --_color-primary: hsl(225 66.7% 1.2%);
      --_color-success: hsl(115 77.5% 27.8%);
      --_color-success-low: hsl(115 77.5% 27.8% / 0.18);
      --_color-success-medium: hsl(115 77.5% 27.8% / 0.6);
      --_color-success-frosted: hsl(109 100% 90% / 0.55);
      --_color-success-frosted-soft: hsl(109 80% 95% / 0.55);
      --_color-warning: hsl(28 97.7% 34.1%);
      --_color-warning-low: hsl(28 97.7% 34.1% / 0.18);
      --_color-warning-medium: hsl(28 97.7% 34.1% / 0.6);
      --_color-warning-frosted: hsl(40 100% 90% / 0.55);
      --_color-warning-frosted-soft: hsl(40 80% 95% / 0.55);
      --_color-error: hsl(357 78% 41%);
      --_color-error-low: hsl(357 78% 41% / 0.18);
      --_color-error-medium: hsl(357 78% 41% / 0.6);
      --_color-error-frosted: hsl(0 100% 90% / 0.55);
      --_color-error-frosted-soft: hsl(0 80% 95% / 0.55);
      --_color-info: hsl(228 83.2% 51%);
      --_color-info-low: hsl(228 83.2% 51% / 0.18);
      --_color-info-medium: hsl(228 83.2% 51% / 0.6);
      --_color-info-frosted: hsl(211 100% 90% / 0.55);
      --_color-info-frosted-soft: hsl(211 80% 95% / 0.55);
    }

    .scheme-dark,
    .scheme-only-dark {
      --_color-focus: #1a44ea;
      --_color-canvas: hsl(225 66.7% 1.2%);
      --_color-surface: hsl(240 2% 10%);
      --_color-frosted: hsl(240 2% 43% / 0.228);
      --_color-frosted-soft: hsl(240 3.7% 26.5% / 0.154);
      --_color-frosted-strong: hsl(240 1.5% 61.8% / 0.302);
      --_color-backdrop: hsl(240 5.3% 14.9% / 0.5);
      --_color-contrast-lower: hsl(240 1.5% 61.8% / 0.302);
      --_color-contrast-low: hsl(240 12.5% 96.9% / 0.45);
      --_color-contrast-medium: hsl(240 12.5% 96.9% / 0.56);
      --_color-contrast-high: hsl(240 12.5% 96.9% / 0.67);
      --_color-contrast-higher: hsl(240 12.5% 96.9% / 0.78);
      --_color-primary: hsl(225 100% 99%);
      --_color-success: hsl(157 84.9% 41.6%);
      --_color-success-low: hsl(157 84.9% 41.6% / 0.18);
      --_color-success-medium: hsl(157 84.9% 41.6% / 0.6);
      --_color-success-frosted: hsl(157 79% 20% / 0.66);
      --_color-success-frosted-soft: hsl(157 59% 15% / 0.66);
      --_color-warning: hsl(28 90.2% 56.1%);
      --_color-warning-low: hsl(28 90.2% 56.1% / 0.18);
      --_color-warning-medium: hsl(28 90.2% 56.1% / 0.6);
      --_color-warning-frosted: hsl(52 79% 20% / 0.66);
      --_color-warning-frosted-soft: hsl(52 59% 15% / 0.66);
      --_color-error: hsl(0 96.9% 62%);
      --_color-error-low: hsl(0 96.9% 62% / 0.18);
      --_color-error-medium: hsl(0 96.9% 62% / 0.6);
      --_color-error-frosted: hsl(0 79% 20% / 0.66);
      --_color-error-frosted-soft: hsl(0 59% 15% / 0.66);
      --_color-info: hsl(210 100% 54.5%);
      --_color-info-low: hsl(210 100% 54.5% / 0.18);
      --_color-info-medium: hsl(210 100% 54.5% / 0.6);
      --_color-info-frosted: hsl(210 79% 20% / 0.66);
      --_color-info-frosted-soft: hsl(210 59% 15% / 0.66);
    }

    @media (prefers-color-scheme: dark) {
      .scheme-light-dark {
        --_color-focus: #1a44ea;
        --_color-canvas: hsl(225 66.7% 1.2%);
        --_color-surface: hsl(240 2% 10%);
        --_color-frosted: hsl(240 2% 43% / 0.228);
        --_color-frosted-soft: hsl(240 3.7% 26.5% / 0.154);
        --_color-frosted-strong: hsl(240 1.5% 61.8% / 0.302);
        --_color-backdrop: hsl(240 5.3% 14.9% / 0.5);
        --_color-contrast-lower: hsl(240 1.5% 61.8% / 0.302);
        --_color-contrast-low: hsl(240 12.5% 96.9% / 0.45);
        --_color-contrast-medium: hsl(240 12.5% 96.9% / 0.56);
        --_color-contrast-high: hsl(240 12.5% 96.9% / 0.67);
        --_color-contrast-higher: hsl(240 12.5% 96.9% / 0.78);
        --_color-primary: hsl(225 100% 99%);
        --_color-success: hsl(157 84.9% 41.6%);
        --_color-success-low: hsl(157 84.9% 41.6% / 0.18);
        --_color-success-medium: hsl(157 84.9% 41.6% / 0.6);
        --_color-success-frosted: hsl(157 79% 20% / 0.66);
        --_color-success-frosted-soft: hsl(157 59% 15% / 0.66);
        --_color-warning: hsl(28 90.2% 56.1%);
        --_color-warning-low: hsl(28 90.2% 56.1% / 0.18);
        --_color-warning-medium: hsl(28 90.2% 56.1% / 0.6);
        --_color-warning-frosted: hsl(52 79% 20% / 0.66);
        --_color-warning-frosted-soft: hsl(52 59% 15% / 0.66);
        --_color-error: hsl(0 96.9% 62%);
        --_color-error-low: hsl(0 96.9% 62% / 0.18);
        --_color-error-medium: hsl(0 96.9% 62% / 0.6);
        --_color-error-frosted: hsl(0 79% 20% / 0.66);
        --_color-error-frosted-soft: hsl(0 59% 15% / 0.66);
        --_color-info: hsl(210 100% 54.5%);
        --_color-info-low: hsl(210 100% 54.5% / 0.18);
