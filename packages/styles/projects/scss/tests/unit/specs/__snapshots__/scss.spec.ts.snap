exports[`should contain correct scss content for file ./dist/_text.scss 1`] = `
"@use "font";
@use "color";

@mixin -prose-text($size) {
  @include font.cjk-font-family;
  font: font.$font-weight-normal $size / font.$leading-normal
    font.$font-porsche-next;
  color: color.$color-primary;
}

@mixin prose-text-5xl {
  @include -prose-text(font.$typescale-5xl);
}
@mixin prose-text-4xl {
  @include -prose-text(font.$typescale-4xl);
}
@mixin prose-text-3xl {
  @include -prose-text(font.$typescale-3xl);
}
@mixin prose-text-2xl {
  @include -prose-text(font.$typescale-2xl);
}
@mixin prose-text-xl {
  @include -prose-text(font.$typescale-xl);
}
@mixin prose-text-lg {
  @include -prose-text(font.$typescale-lg);
}
@mixin prose-text-md {
  @include -prose-text(font.$typescale-md);
}
@mixin prose-text-sm {
  @include -prose-text(font.$typescale-sm);
}
@mixin prose-text-xs {
  @include -prose-text(font.$typescale-xs);
}
@mixin prose-text-2xs {
  @include -prose-text(font.$typescale-2xs);
}
