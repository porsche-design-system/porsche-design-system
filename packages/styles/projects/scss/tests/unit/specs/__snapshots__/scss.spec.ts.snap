      --_color-contrast-high: hsl(240 7.1% 11% / 0.7);
      --_color-contrast-higher: hsl(240 8.7% 9% / 0.8);
      --_color-primary: hsl(225 66.7% 1.2%);
      --_color-success: hsl(115 77.5% 27.8%);
      --_color-success-low: hsl(115 77.5% 27.8% / 0.18);
      --_color-success-medium: hsl(115 77.5% 27.8% / 0.6);
      --_color-success-frosted: hsl(109 100% 90% / 0.55);
      --_color-success-frosted-soft: hsl(109 80% 95% / 0.55);
      --_color-warning: hsl(28 97.7% 34.1%);
      --_color-warning-low: hsl(28 97.7% 34.1% / 0.18);
      --_color-warning-medium: hsl(28 97.7% 34.1% / 0.6);
      --_color-warning-frosted: hsl(40 100% 90% / 0.55);
      --_color-warning-frosted-soft: hsl(40 80% 95% / 0.55);
      --_color-error: hsl(357 78% 41%);
