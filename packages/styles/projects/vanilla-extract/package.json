{
  "name": "@porsche-design-system/vanilla-extract",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "homepage": "https://designsystem.porsche.com",
  "sideEffects": false,
  "type": "commonjs",
  "files": [
    "./dist/",
    "./meta/"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/cjs/index.cjs"
    },
    "./meta": {
      "types": "./meta/esm/vanillaExtractMeta/index.d.ts",
      "import": "./meta/esm/index.mjs",
      "default": "./meta/cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "npm run clean:build && npm run build:bundle && npm run build:bundle:meta",
    "build:bundle": "rollup -c rollup.config.mjs --bundleConfigAsCjs",
    "build:bundle:meta": "rollup -c rollup-meta.config.mjs --bundleConfigAsCjs",
    "generateVanillaExtractTestStyles": "rollup -c rollup-test-ve.config.mjs --bundleConfigAsCjs",
    "test": "npm run test:unit",
    "test:unit": "npm run generateVanillaExtractTestStyles && vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./dist ./meta"
  },
  "dependencies": {
    "@porsche-design-system/tokens": "0.0.0"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0"
  },
  "peerDependencies": {
    "@biomejs/biome": "*",
    "@rollup/plugin-node-resolve": "*",
    "@types/node": "*",
    "@vanilla-extract/css": "*",
    "@vanilla-extract/rollup-plugin": "*",
    "@vanilla-extract/vite-plugin": "*",
    "rollup": "*",
    "rollup-plugin-generate-package-json": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "volta": {
    "extends": "../../../../package.json"
  }
}
