{
  "extends": "shared/tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // `skill/skill.ts` is published as raw source (`exports["./skill"]`) and imports `node:fs`/`node:path`,
    // matching the scss and tailwindcss flavours which already declare this for the same reason.
    "types": ["node"]
  },
  "include": ["./src", "./vanillaExtractMeta", "./skill"],
  "exclude": ["**/*.spec.ts"]
}
