{
  "name": "@porsche-design-system/emotion",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "main": "dist/styles/cjs/index.cjs",
  "module": "dist/styles/esm/index.mjs",
  "types": "dist/styles/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/styles/esm/index.d.ts",
      "import": "./dist/styles/esm/index.mjs",
      "default": "./dist/styles/cjs/index.cjs"
    },
    "./meta": {
      "types": "./dist/meta/esm/meta.d.ts",
      "import": "./dist/meta/esm/meta.mjs",
      "default": "./dist/meta/cjs/meta.cjs"
    }
  },
  "scripts": {
    "build": "npm run clean:build && npm run generate:styles && npm run build:bundle",
    "build:bundle": "rollup -c rollup.config.js --bundleConfigAsCjs",
    "test": "npm run test:unit",
    "test:unit": "npm run generate:styles && vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./dist",
    "generate:styles": "tsx scripts/generateEmotionStyles.ts"
  },
  "dependencies": {
    "@porsche-design-system/tokens": "0.0.0"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0",
    "react-jss": "^10.10.0"
  },
  "peerDependencies": {
    "@types/madge": "*",
    "@types/node": "*",
    "prettier": "*",
    "madge": "*",
    "typescript": "*",
    "@rollup/plugin-node-resolve": "*",
    "@rollup/plugin-typescript": "*",
    "rollup-plugin-generate-package-json": "*",
    "jss": "*",
    "jss-plugin-camel-case": "*",
    "jss-plugin-global": "*",
    "jss-plugin-nested": "*",
    "jss-plugin-sort-css-media-queries": "*"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
