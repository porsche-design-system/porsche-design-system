{
  "name": "@porsche-design-system/emotion",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/cjs/index.cjs"
    },
    "./meta": {
      "types": "./meta/esm/emotionMeta/index.d.ts",
      "import": "./meta/esm/index.mjs",
      "default": "./meta/cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "npm run clean:build && npm run build:bundle && npm run build:bundle:meta",
    "build:bundle": "rollup -c rollup.config.mjs --bundleConfigAsCjs",
    "build:bundle:meta": "rollup -c rollup-meta.config.mjs --bundleConfigAsCjs",
    "test": "npm run test:unit",
    "test:unit": "vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./dist ./meta"
  },
  "dependencies": {
    "@porsche-design-system/tokens": "0.0.0"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/madge": "^5.0.3",
    "@types/node": "^25.9.3",
    "jss": "^10.10.0",
    "jss-plugin-camel-case": "^10.10.0",
    "jss-plugin-global": "^10.10.0",
    "jss-plugin-nested": "^10.10.0",
    "jss-plugin-sort-css-media-queries": "^1.0.1-beta.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.4",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "typescript": "^6.0.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
