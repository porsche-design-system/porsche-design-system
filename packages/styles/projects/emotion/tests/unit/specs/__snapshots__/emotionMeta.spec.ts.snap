      "name": "gridWideOffsetS",
      "value": "calc(5vw - 16px)",
    },
    "gridWideOffsetXXL": {
      "description": "Holds a **xxl** offset within the \`wide\` area of the Porsche Grid.",
      "name": "gridWideOffsetXXL",
      "value": "calc(max(0px, 50vw - 2560px / 2) + min(50vw - 880px, 400px))",
    },
  },
  "mediaQuery": {
    "getMediaQueryMax": {
      "description": "Applies a **max** media query with the specified breakpoint.",
      "name": "getMediaQueryMax",
      "styles": "function getMediaQueryMax(max) {
	return \`@media(max-width:\${__vite_ssr_import_0__.breakpoint[max] - 1}px)\`;
}",
    },
    "getMediaQueryMin": {
      "description": "Applies a **min** media query with the specified breakpoint.",
      "name": "getMediaQueryMin",
      "styles": "function getMediaQueryMin(min) {
	return \`@media(min-width:\${__vite_ssr_import_0__.breakpoint[min]}px)\`;
}",
    },
    "getMediaQueryMinMax": {
      "description": "Applies a **min-max** media query with the specified breakpoints.",
      "name": "getMediaQueryMinMax",
      "styles": "function getMediaQueryMinMax(min, max) {
	return \`@media(min-width:\${__vite_ssr_import_0__.breakpoint[min]}px) and (max-width:\${__vite_ssr_import_0__.breakpoint[max] - 1}px)\`;
}",
    },
  },
  "motion": {
    "duration": {
      "lg": {
        "description": "Holds a **long** \`transition-duration\` / \`animation-duration\`.",
