  "focus": {
    "getFocusStyle": {
      "deprecated": true,
      "description": "deprecated since v4.0.0, will be removed with next major release. Use getFocusVisibleStyle instead.",
      "name": "getFocusStyle",
      "value": "(opts) => {
	const { borderRadius, offset } = opts || {};
	return {
		...getFocusStyles(borderRadius),
		...getFocusNestedStyles(offset)
	};
}",
    },
    "getFocusVisibleStyle": {
      "description": "Applies a **focus-visible** style.",
      "name": "getFocusVisibleStyle",
      "value": "(opts) => {
	const { offset = "2px" } = opts || {};
	return { "&:focus-visible": {
		outline: \`2px solid \${__vite_ssr_import_0__.colorFocus}\`,
		outlineOffset: offset
	} };
}",
    },
  },
