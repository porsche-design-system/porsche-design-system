  "grid": {
    "gridBasic": {
      "description": "Object containing all \`basic\` grid styles.",
      "name": "gridBasic",
      "value": {
        "columnEnd": "basic-end",
        "columnStart": "basic-start",
        "spanOneHalf": "var(--pds-grid-basic-span-one-half)",
        "spanOneThird": "var(--pds-grid-basic-span-one-third)",
        "spanTwoThirds": "var(--pds-grid-basic-span-two-thirds)",
      },
    },
    "gridBasicColumnEnd": {
      "description": "Holds the **end** position of the \`basic\` area within the Porsche Grid.",
      "name": "gridBasicColumnEnd",
      "value": "basic-end",
    },
    "gridBasicColumnStart": {
      "description": "Holds the **start** position of the \`basic\` area within the Porsche Grid.",
      "name": "gridBasicColumnStart",
      "value": "basic-start",
    },
    "gridBasicOffset": {
      "description": "Object containing all \`basic\` grid offset styles.",
      "name": "gridBasicOffset",
      "value": {
        "base": "max(22px, 10.625vw - 12px)",
        "s": "calc(calc(5vw - 16px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((100vw - calc(5vw - 16px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 2)",
        "xxl": "calc(max(0px, 50vw - 2560px / 2) + min(50vw - 880px, 400px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((min(100vw, 2560px) - min(50vw - 880px, 400px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 2)",
      },
    },
    "gridBasicOffsetBase": {
      "description": "Holds a **base** offset within the \`basic\` area of the Porsche Grid.",
      "name": "gridBasicOffsetBase",
      "value": "max(22px, 10.625vw - 12px)",
    },
    "gridBasicOffsetS": {
      "description": "Holds a **small** offset within the \`basic\` area of the Porsche Grid.",
      "name": "gridBasicOffsetS",
      "value": "calc(calc(5vw - 16px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((100vw - calc(5vw - 16px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 2)",
    },
    "gridBasicOffsetXXL": {
      "description": "Holds a **xxl** offset within the \`basic\` area of the Porsche Grid.",
      "name": "gridBasicOffsetXXL",
      "value": "calc(max(0px, 50vw - 2560px / 2) + min(50vw - 880px, 400px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((min(100vw, 2560px) - min(50vw - 880px, 400px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 2)",
    },
    "gridBasicSpanOneHalf": {
      "description": "Holds a **half** span within the \`basic\` area of the Porsche Grid.",
