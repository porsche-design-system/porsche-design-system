      "description": "Object containing all \`full\` grid styles.",
      "name": "gridFull",
      "value": {
        "columnEnd": "full-end",
        "columnStart": "full-start",
      },
    },
    "gridFullColumnEnd": {
      "description": "Holds the **end** position of the \`full\` area within the Porsche Grid.",
      "name": "gridFullColumnEnd",
      "value": "full-end",
    },
    "gridFullColumnStart": {
      "description": "Holds the **start** position of the \`full\` area within the Porsche Grid.",
      "name": "gridFullColumnStart",
      "value": "full-start",
    },
    "gridFullOffset": {
      "description": "Holds a **full** offset within the \`full\` area of the Porsche Grid.",
      "name": "gridFullOffset",
      "value": "max(0px, 50vw - 2560px / 2)",
    },
    "gridGap": {
      "description": "Holds the grid **gap** of the Porsche Grid.",
      "name": "gridGap",
      "value": "clamp(16px, 1.25vw + 12px, 36px)",
    },
    "gridNarrow": {
      "description": "Object containing all \`narrow\` grid styles.",
      "name": "gridNarrow",
      "value": {
        "columnEnd": "narrow-end",
        "columnStart": "narrow-start",
        "spanOneHalf": "var(--pds-grid-narrow-span-one-half)",
      },
    },
    "gridNarrowColumnEnd": {
      "description": "Holds the **end** position of the \`narrow\` area within the Porsche Grid.",
      "name": "gridNarrowColumnEnd",
      "value": "narrow-end",
    },
    "gridNarrowColumnStart": {
      "description": "Holds the **start** position of the \`narrow\` area within the Porsche Grid.",
      "name": "gridNarrowColumnStart",
      "value": "narrow-start",
    },
    "gridNarrowOffset": {
      "description": "Object containing all \`narrow\` grid offset styles.",
      "name": "gridNarrowOffset",
      "value": {
        "base": "max(22px, 10.625vw - 12px)",
        "s": "calc(calc(5vw - 16px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((100vw - calc(5vw - 16px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 4)",
        "xxl": "calc(max(0px, 50vw - 2560px / 2) + min(50vw - 880px, 400px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((min(100vw, 2560px) - min(50vw - 880px, 400px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 4)",
      },
    },
    "gridNarrowOffsetBase": {
      "description": "Holds a **base** offset within the \`narrow\` area of the Porsche Grid.",
      "name": "gridNarrowOffsetBase",
      "value": "max(22px, 10.625vw - 12px)",
    },
    "gridNarrowOffsetS": {
      "description": "Holds a **small** offset within the \`narrow\` area of the Porsche Grid.",
      "name": "gridNarrowOffsetS",
      "value": "calc(calc(5vw - 16px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((100vw - calc(5vw - 16px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 4)",
    },
    "gridNarrowOffsetXXL": {
      "description": "Holds a **xxl** offset within the \`narrow\` area of the Porsche Grid.",
      "name": "gridNarrowOffsetXXL",
      "value": "calc(max(0px, 50vw - 2560px / 2) + min(50vw - 880px, 400px) + (clamp(16px, 1.25vw + 12px, 36px) + calc((min(100vw, 2560px) - min(50vw - 880px, 400px) * 2 - clamp(16px, 1.25vw + 12px, 36px) * 15) / 16)) * 4)",
    },
    "gridNarrowSpanOneHalf": {
      "description": "Holds a **one half** span within the \`narrow\` area of the Porsche Grid.",
      "name": "gridNarrowSpanOneHalf",
      "value": "var(--pds-grid-narrow-span-one-half)",
    },
    "gridStyle": {
      "description": "Applies the **Porsche Grid** layout system (must be applied once at the top level, span the full viewport width, and cannot be nested).",
      "name": "gridStyle",
      "value": {
        "--pds-grid-basic-span-one-half": "span 3",
        "--pds-grid-basic-span-one-third": "span 2",
        "--pds-grid-basic-span-two-thirds": "span 4",
        "--pds-grid-extended-span-one-half": "span 3",
        "--pds-grid-narrow-span-one-half": "span 3",
        "--pds-internal-grid-safe-zone": "max(22px, 10.625vw - 12px)",
        "@media(min-width:1920px)": {
          "--pds-internal-grid-safe-zone": "min(50vw - 880px, 400px)",
        },
        "@media(min-width:760px)": {
          "--pds-grid-basic-span-one-half": "span 6",
          "--pds-grid-basic-span-one-third": "span 4",
          "--pds-grid-basic-span-two-thirds": "span 8",
          "--pds-grid-extended-span-one-half": "span 7",
          "--pds-grid-narrow-span-one-half": "span 4",
          "--pds-internal-grid-safe-zone": "calc(5vw - 16px)",
          "gridTemplateColumns": "[full-start] minmax(0,var(--pds-internal-grid-outer-column,calc(var(--pds-internal-grid-safe-zone) - clamp(16px, 1.25vw + 12px, 36px)))) [wide-start] minmax(0,1fr) [extended-start] minmax(0,1fr) [basic-start] repeat(2, minmax(0,1fr)) [narrow-start] repeat(8, minmax(0,1fr)) [narrow-end] repeat(2, minmax(0,1fr)) [basic-end] minmax(0,1fr) [extended-end] minmax(0,1fr) [wide-end] minmax(0,var(--pds-internal-grid-outer-column,calc(var(--pds-internal-grid-safe-zone) - clamp(16px, 1.25vw + 12px, 36px)))) [full-end]",
        },
        "boxSizing": "content-box",
        "display": "grid",
        "gridGap": "clamp(16px, 1.25vw + 12px, 36px)",
        "gridTemplateColumns": "[full-start] minmax(0,var(--pds-internal-grid-outer-column,calc(var(--pds-internal-grid-safe-zone) - clamp(16px, 1.25vw + 12px, 36px)))) [wide-start extended-start basic-start narrow-start] repeat(6, minmax(0,1fr)) [narrow-end basic-end extended-end wide-end] minmax(0,var(--pds-internal-grid-outer-column,calc(var(--pds-internal-grid-safe-zone) - clamp(16px, 1.25vw + 12px, 36px)))) [full-end]",
        "margin": "0 var(--pds-internal-grid-margin,0)",
        "maxWidth": "var(--pds-internal-grid-width-max,2560px)",
        "minWidth": "var(--pds-internal-grid-width-min,320px)",
        "padding": "0 calc(50% - var(--pds-internal-grid-margin,0px) - 2560px / 2)",
      },
    },
    "gridWide": {
      "description": "Object containing all \`wide\` grid styles.",
      "name": "gridWide",
      "value": {
        "columnEnd": "wide-end",
        "columnStart": "wide-start",
      },
    },
    "gridWideColumnEnd": {
      "description": "Holds the **end** position of the \`wide\` area within the Porsche Grid.",
      "name": "gridWideColumnEnd",
      "value": "wide-end",
    },
    "gridWideColumnStart": {
      "description": "Holds the **start** position of the \`wide\` area within the Porsche Grid.",
      "name": "gridWideColumnStart",
      "value": "wide-start",
    },
    "gridWideOffset": {
      "description": "Object containing all \`wide\` grid offset styles.",
      "name": "gridWideOffset",
      "value": {
        "base": "max(22px, 10.625vw - 12px)",
        "s": "calc(5vw - 16px)",
        "xxl": "calc(max(0px, 50vw - 2560px / 2) + min(50vw - 880px, 400px))",
      },
    },
    "gridWideOffsetBase": {
      "description": "Holds a **base** offset within the \`wide\` area of the Porsche Grid.",
      "name": "gridWideOffsetBase",
      "value": "max(22px, 10.625vw - 12px)",
    },
    "gridWideOffsetS": {
      "description": "Holds a **small** offset within the \`wide\` area of the Porsche Grid.",
      "name": "gridWideOffsetS",
      "value": "calc(5vw - 16px)",
    },
    "gridWideOffsetXXL": {
      "description": "Holds a **xxl** offset within the \`wide\` area of the Porsche Grid.",
      "name": "gridWideOffsetXXL",
      "value": "calc(max(0px, 50vw - 2560px / 2) + min(50vw - 880px, 400px))",
    },
  },
  "mediaQuery": {
    "getMediaQueryMax": {
      "description": "Applies a **max** media query with the specified breakpoint.",
