  "skeleton": {
    "getSkeletonStyle": {
      "description": "Applies a skeleton placeholder style to indicate loading state.",
      "name": "getSkeletonStyle",
      "value": "() => {
	return {
		"@keyframes skeleton": {
			from: { backgroundPositionX: "100%" },
			to: { backgroundPositionX: "-100%" }
		},
		display: "block",
		borderRadius: __vite_ssr_import_0__.radiusSm,
		background: \`transparent linear-gradient(to right, \${__vite_ssr_import_1__.colorFrosted} 0%, \${__vite_ssr_import_1__.colorFrostedStrong} 50%, \${__vite_ssr_import_1__.colorFrosted} 100%) 0 0 / 200% 100%\`,
		animation: \`skeleton \${__vite_ssr_import_2__.durationXl} \${__vite_ssr_import_2__.easeInOut} infinite\`
	};
}",
    },
  },
