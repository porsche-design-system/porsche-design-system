	return \`@media(max-width:\${__vite_ssr_import_0__.breakpoint[max] - 1}px)\`;
}",
    },
    "getMediaQueryMin": {
      "description": "Applies a **min** media query with the specified breakpoint.",
      "name": "getMediaQueryMin",
      "value": "function getMediaQueryMin(min) {
	return \`@media(min-width:\${__vite_ssr_import_0__.breakpoint[min]}px)\`;
}",
    },
    "getMediaQueryMinMax": {
      "description": "Applies a **min-max** media query with the specified breakpoints.",
      "name": "getMediaQueryMinMax",
      "value": "function getMediaQueryMinMax(min, max) {
	return \`@media(min-width:\${__vite_ssr_import_0__.breakpoint[min]}px) and (max-width:\${__vite_ssr_import_0__.breakpoint[max] - 1}px)\`;
}",
    },
