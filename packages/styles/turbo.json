{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["shared#build", "@porsche-design-system/tokens#build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx", "!projects/*/meta/**", "!projects/shared-styles/src/generated/**"],
      "outputs": ["dist/**", "projects/*/dist/**", "projects/*/meta/**", "projects/shared-styles/src/generated/**"]
    },
    "build-prod": {
      "dependsOn": ["shared#build", "@porsche-design-system/tokens#build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx", "!projects/*/meta/**", "!projects/shared-styles/src/generated/**"],
      "outputs": ["dist/**", "projects/*/dist/**", "projects/*/meta/**", "projects/shared-styles/src/generated/**"]
    }
  }
}
