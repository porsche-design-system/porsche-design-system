{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["@porsche-design-system/stylesheets#build", "@porsche-design-system/assets#build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.spec.tsx", "!**/*.test.ts", "!**/*.test.tsx", "!src/lib/**"],
      "outputs": ["dist/**", "src/lib/**"]
    }
  }
}
