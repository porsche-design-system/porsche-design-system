{
  "name": "@porsche-design-system/component-meta",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "homepage": "https://designsystem.porsche.com",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/cjs/index.cjs"
    },
    "./utils": {
      "types": "./dist/esm/utils/index.d.ts",
      "import": "./dist/esm/utils/index.mjs",
      "default": "./dist/cjs/utils/index.cjs"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "npm run clean:build && npm run build:generateComponentMeta && npm run build:bundle",
    "build:generateComponentMeta": "tsx scripts/generateComponentMeta.ts",
    "build:bundle": "rollup -c rollup.config.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest --config tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./src/lib && rm -rf ./dist"
  },
  "devDependencies": {
    "@porsche-design-system/shared": "0.0.0",
    "change-case": "^5.4.4",
    "fast-glob": "^3.3.3",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
