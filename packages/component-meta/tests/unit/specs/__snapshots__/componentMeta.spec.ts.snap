  "p-link-tile": {
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": false,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": true,
    "isInternal": false,
    "nestedComponents": [
      "p-link",
    ],
    "propsMeta": {
      "align": {
        "allowedValues": [
          "top",
          "bottom",
        ],
        "defaultValue": "bottom",
        "description": "Controls the vertical placement of the description and link — \`top\` or \`bottom\`.",
        "type": "LinkTileAlign",
      },
      "aria": {
        "allowedValues": {
          "aria-current": "string",
          "aria-description": "string",
          "aria-haspopup": "string",
          "aria-label": "string",
        },
        "defaultValue": null,
        "description": "Sets ARIA attributes on the tile's anchor element to improve accessibility for screen readers.",
        "isAria": true,
        "type": "LinkTileAriaAttribute",
      },
      "aspectRatio": {
        "allowedValues": [
          "1/1",
          "4/3",
          "3/4",
          "16/9",
          "9/16",
          "auto",
        ],
        "defaultValue": "4/3",
        "description": "Sets the width-to-height ratio of the tile media area. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "LinkTileAspectRatio",
      },
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Renders only the icon link without the full label. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "description": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the description text displayed in the tile's content area.",
        "isRequired": true,
        "type": "string",
      },
      "download": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the native \`download\` attribute to trigger a file download.",
        "type": "string",
      },
      "gradient": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Shows a gradient overlay over the media slot to improve text legibility on bright images or videos.",
        "type": "boolean",
      },
      "href": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the URL the tile's anchor element navigates to when clicked.",
        "isRequired": true,
        "type": "string",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the accessible label text of the link rendered inside the tile.",
        "isRequired": true,
        "type": "string",
      },
      "rel": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the \`rel\` attribute on the link (e.g. \`noopener\`).",
        "type": "string",
      },
      "size": {
        "allowedValues": [
          "medium",
          "large",
          "inherit",
        ],
        "defaultValue": "medium",
        "description": "Sets the font size of the description text in the tile content area. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
