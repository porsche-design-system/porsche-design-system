  "p-select": {
    "controlledMeta": [
      {
        "event": "change",
        "isInternallyMutated": true,
        "props": [
          "value",
        ],
      },
    ],
    "eventsMeta": {
      "blur": {
        "description": "Emitted when the select component loses focus, useful for triggering validation on blur.",
        "type": "void",
      },
      "change": {
        "description": "Emitted when the user selects a different option, carrying the new value in the event detail.",
        "type": "SelectChangeEventDetail",
        "typeDetail": "{ name: string; value: string }",
      },
      "toggle": {
        "description": "Emitted when the dropdown list opens or closes, carrying the new \`isOpen\` state in the event detail.",
        "type": "SelectToggleEventDetail",
        "typeDetail": "{ open: boolean }",
      },
    },
    "hasAriaProp": false,
    "hasElementInternals": true,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": true,
    "isInternal": false,
    "nestedComponents": [
      "p-icon",
      "p-input-search",
    ],
    "propsMeta": {
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Reduces the control height and padding for use in dense layouts where vertical space is limited.",
        "type": "boolean",
      },
      "description": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets a supplementary description displayed below the label to give users additional guidance about the select.",
        "type": "string",
      },
      "disabled": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Prevents user interaction with the select and excludes its value from form submissions.",
        "propOptions": {
          "mutable": true,
        },
        "type": "boolean",
      },
      "dropdownDirection": {
        "allowedValues": [
          "down",
          "up",
          "auto",
        ],
        "defaultValue": "auto",
        "description": "Controls whether the dropdown list opens upward (\`up\`) or downward (\`down\`), or determines the direction automatically (\`auto\`).",
        "type": "SelectDropdownDirection",
      },
      "filter": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Shows a text input inside the dropdown that filters the visible options as the user types. Ignored when the \`filter\` slot is used.",
        "type": "boolean",
      },
      "form": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Associates the select with a form element by its ID when it is not a direct descendant of that form.",
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "hideLabel": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Hides the visible label while keeping it accessible to screen readers. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the visible label text displayed above the select control to identify its purpose.",
        "type": "string",
      },
      "message": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the validation feedback message displayed below the select when \`state\` is \`success\` or \`error\`.",
        "type": "string",
      },
      "name": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the name of the control submitted with the form data, identifying the selected value on the server.",
        "isRequired": true,
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "required": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Marks the select as required so the form cannot be submitted unless a non-empty option is selected.",
        "type": "boolean",
      },
      "state": {
        "allowedValues": [
          "none",
          "error",
          "success",
        ],
        "defaultValue": "none",
        "description": "Sets the validation state of the select, which controls its visual appearance and feedback message style (\`none\`, \`success\`, \`error\`).",
        "type": "SelectState",
      },
      "value": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the currently selected option value; update this to control the selection programmatically.",
        "propOptions": {
          "mutable": true,
        },
        "type": "string",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for the \`p-select-option\` tags.",
      },
      "description": {
        "description": "Shows a description. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "filter": {
        "description": "Optional slot for providing a custom \`p-input-search\` input. When used, the default filter input is replaced and the built-in filter logic is disabled, giving full control over filtering behavior.",
      },
      "label": {
        "description": "Shows a label. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "label-after": {
        "description": "Places additional content after the label text (for content that should not be part of the label, e.g. external links or \`p-popover\`).",
      },
      "message": {
        "description": "Shows a state message. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "options-status": {
        "description": "When implementing a custom filter with the \`filter\` slot, use this slot for loading, error and no results status.",
      },
      "selected": {
        "description": "Use this slot to provide custom markup for the selected option display in the button area.",
      },
    },
    "styling": "jss",
  },
