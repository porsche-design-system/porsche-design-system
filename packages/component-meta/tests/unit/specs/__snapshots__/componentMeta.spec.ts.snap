    ],
    "propsMeta": {
      "disabled": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Prevents this option from being selected and excludes its value from form submissions while it is disabled.",
        "type": "boolean",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the visible label text displayed next to the radio button that the user reads to identify the option.",
        "type": "string",
      },
      "loading": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "@experimental Disables this option and shows a spinner to indicate that this particular option is in a loading state.",
        "isExperimental": true,
        "type": "boolean",
      },
      "value": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the value submitted with the form data when this radio option is selected within its parent group.",
        "type": "string",
      },
    },
    "requiredParent": [
      "p-radio-group",
    ],
    "slotsMeta": {
      "label": {
        "description": "Shows a label. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "label-after": {
        "description": "Places additional content after the label text (for content that should not be part of the label, e.g. external links or \`p-popover\`).",
      },
    },
    "styling": "jss",
  },
  "p-scroller": {
    "cssVariablesMeta": {
      "--p-scroller-gap": {
        "defaultValue": "8px",
        "description": "Defines the gap between slotted nodes.",
      },
      "--p-scroller-indicator-bottom": {
        "defaultValue": "0px",
        "description": "Defines the distance from the bottom of the viewport at which the indicator sticks when scrolling up and \`sticky\` is enabled.",
      },
      "--p-scroller-indicator-top": {
        "defaultValue": "0px",
        "description": "Defines the distance from the top of the viewport at which the indicator sticks when scrolling down and \`sticky\` is enabled.",
      },
    },
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": false,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": false,
    "isInternal": false,
    "propsMeta": {
      "alignScrollIndicator": {
        "allowedValues": [
          "top",
          "center",
        ],
        "defaultValue": "center",
        "description": "@deprecated since v4.0.0, will be removed with next major release, has no effect anymore.",
        "isDeprecated": true,
        "type": "ScrollerAlignScrollIndicator",
      },
      "aria": {
        "allowedValues": {
          "role": "string",
        },
        "defaultValue": null,
        "description": "Sets the ARIA \`role\` attribute on the scroller's scroll container, useful for list-based navigation patterns.",
        "isAria": true,
        "type": "ScrollerAriaAttribute",
      },
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": null,
        "description": "Reduces the scroller's padding and the gap between slotted items for use in dense layouts.",
        "type": "boolean",
      },
      "scrollToPosition": {
        "allowedValues": {
          "isSmooth": "boolean",
          "scrollPosition": "number",
        },
        "defaultValue": null,
        "description": "@deprecated since v4.0.0, use native \`scrollIntoView()\` on the slotted element itself.",
        "isDeprecated": true,
        "propOptions": {
          "mutable": true,
        },
        "type": "ScrollerScrollToPosition",
      },
      "scrollbar": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Shows the browser's native scrollbar inside the scroller, in addition to the scroll indicator arrows.",
        "type": "boolean",
      },
      "sticky": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "@experimental Makes the indicator sticky at the top or bottom while scrolling depending on the scroll direction.",
        "isExperimental": true,
        "type": "boolean",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for the scroller content.",
      },
    },
    "styling": "jss",
