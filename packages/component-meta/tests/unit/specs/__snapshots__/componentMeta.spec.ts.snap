          "3xl",
          "4xl",
          "5xl",
          "inherit",
          "small",
          "medium",
          "large",
        ],
        "defaultValue": "sm",
        "deprecatedValues": [
          "small",
          "medium",
          "large",
        ],
        "description": "Sets the size of the spinner using the PDS typographic scale. Use \`inherit\` to derive the size from the parent element's font-size. Supports responsive breakpoint values.",
