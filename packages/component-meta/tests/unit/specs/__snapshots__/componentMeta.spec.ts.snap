        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the supporting description text shown below the heading.",
        "type": "string",
      },
      "dismissButton": {
        "allowedValues": "boolean",
        "defaultValue": true,
        "description": "Shows a dismiss button so the user can manually close the banner.",
        "type": "boolean",
      },
      "heading": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the heading text displayed at the top of the banner.",
        "type": "string",
      },
      "headingTag": {
        "allowedValues": [
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6",
        ],
        "defaultValue": "h5",
        "description": "Sets the HTML heading tag (e.g. h2, h3) to maintain correct document structure for the heading.",
        "type": "BannerHeadingTag",
      },
      "open": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Controls whether the banner is visible. Set to \`true\` to show it and \`false\` to hide it.",
        "isRequired": true,
        "type": "boolean",
      },
      "position": {
        "allowedValues": [
          "top",
          "bottom",
        ],
        "defaultValue": {
          "base": "bottom",
          "s": "top",
        },
        "description": "Sets the position of the banner on screen — \`top\` or \`bottom\`. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "BannerPosition",
      },
      "state": {
        "allowedValues": [
          "info",
          "success",
          "warning",
          "error",
        ],
        "defaultValue": "info",
