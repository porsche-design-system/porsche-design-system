  "p-modal": {
    "controlledMeta": [
      {
        "event": "dismiss",
        "props": [
          "open",
        ],
      },
    ],
    "cssVariablesMeta": {
      "--p-modal-spacing-bottom": {
        "defaultValue": "clamp(16px, 10vh, 192px)",
        "description": "Spacing of the modal to the bottom.",
      },
      "--p-modal-spacing-top": {
        "defaultValue": "clamp(16px, 10vh, 192px)",
        "description": "Spacing of the modal to the top.",
      },
      "--p-modal-width": {
        "defaultValue": "auto",
        "description": "Width of the modal.",
      },
      "--ref-p-modal-pb": {
        "description": "Exposes the internally used padding-bottom of the Modal as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the bottom of the Modal.",
      },
      "--ref-p-modal-pt": {
        "description": "Exposes the internally used padding-top of the Modal as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the top of the Modal.",
      },
      "--ref-p-modal-px": {
        "description": "Exposes the internally used padding-inline of the Modal as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the full horizontal size of the Modal.",
      },
    },
    "eventsMeta": {
      "dismiss": {
        "description": "Emitted when the user closes the modal via the dismiss button, backdrop click, or Escape key.",
        "type": "void",
      },
      "motionHiddenEnd": {
        "description": "Emitted after the modal's close transition completes and the dialog is fully hidden.",
        "type": "ModalMotionHiddenEndEventDetail",
        "typeDetail": "TransitionEvent",
      },
      "motionVisibleEnd": {
        "description": "Emitted after the modal's open transition completes and the dialog is fully visible.",
        "type": "ModalMotionVisibleEndEventDetail",
        "typeDetail": "TransitionEvent",
      },
    },
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": true,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": false,
    "isInternal": false,
    "nestedComponents": [
      "p-button",
    ],
    "propsMeta": {
      "aria": {
        "allowedValues": {
          "aria-label": "string",
          "role": "string",
        },
        "defaultValue": null,
        "description": "Sets ARIA attributes on the dialog element for improved accessibility when no visible heading is present.",
        "isAria": true,
        "type": "ModalAriaAttribute",
      },
      "backdrop": {
        "allowedValues": [
          "blur",
          "shading",
        ],
        "defaultValue": "blur",
        "description": "Sets the backdrop style. Use \`blur\` when the modal is opened by user interaction; use \`shading\` when opened automatically (e.g. Cookie Consent).",
        "type": "ModalBackdrop",
      },
      "background": {
        "allowedValues": [
          "canvas",
          "surface",
        ],
        "defaultValue": "canvas",
        "description": "Sets the background color of the modal panel (\`canvas\` or \`surface\`).",
        "type": "ModalBackground",
      },
      "disableBackdropClick": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "When enabled, clicking the backdrop will not close the modal — users must use the dismiss button.",
        "type": "boolean",
      },
      "dismissButton": {
        "allowedValues": "boolean",
        "defaultValue": true,
        "description": "Shows a dismiss button in the modal header so the user can manually close it.",
        "type": "boolean",
      },
      "fullscreen": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Expands the modal to the full viewport size, intended for mobile use cases. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "open": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Controls whether the modal dialog is visible.",
        "isRequired": true,
        "type": "boolean",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for the main content.",
      },
      "footer": {
        "description": "Shows a sticky footer section, flowing under the content area when scrollable.",
      },
      "header": {
        "description": "Renders a header section above the content area.",
      },
    },
    "styling": "jss",
  },
  "p-model-signature": {
    "cssVariablesMeta": {
      "--p-model-signature-color": {
        "defaultValue": "",
        "description": "Overrides the fill color of the model signature. Overrides the \`color\` property when set.",
      },
      "--p-model-signature-height": {
        "defaultValue": "auto",
        "description": "Overrides the height of the model signature.",
      },
      "--p-model-signature-width": {
        "defaultValue": "",
        "description": "Overrides the width of the model signature. Only takes effect when \`size\` is not \`inherit\`.",
      },
    },
    "hasAriaProp": false,
    "hasElementInternals": false,
    "hasEvent": false,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": false,
    "isInternal": false,
    "propsMeta": {
      "color": {
        "allowedValues": [
          "primary",
          "contrast-low",
          "contrast-medium",
          "contrast-high",
          "inherit",
        ],
        "defaultValue": "primary",
        "description": "Sets the fill color of the signature using PDS color tokens.",
        "type": "ModelSignatureColor",
      },
      "fetchPriority": {
        "allowedValues": [
          "low",
          "high",
          "auto",
        ],
        "defaultValue": "auto",
        "description": "Sets the browser's fetch priority hint for the signature asset (\`auto\`, \`high\`, \`low\`).",
        "type": "ModelSignatureFetchPriority",
      },
      "lazy": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Defers loading the signature until it enters the viewport to improve initial page performance.",
        "type": "boolean",
      },
      "model": {
        "allowedValues": [
          "718",
          "911",
          "boxster",
          "cayenne",
          "cayman",
          "gt3-rs",
          "gt3",
          "gts",
          "macan",
          "panamera",
          "taycan",
          "turbo-s",
          "turbo",
        ],
        "defaultValue": "911",
        "description": "Selects the Porsche model whose typographic signature SVG is displayed.",
        "type": "ModelSignatureModel",
      },
      "safeZone": {
        "allowedValues": "boolean",
        "defaultValue": true,
        "description": "When enabled, adds invisible padding so all model signatures visually align to a consistent baseline.",
        "type": "boolean",
      },
      "size": {
        "allowedValues": [
          "small",
          "inherit",
        ],
        "defaultValue": "small",
        "description": "Sets the display size of the signature using predefined PDS sizes. Use \`inherit\` with a CSS \`width\` or \`height\` on the host for custom sizing.",
        "type": "ModelSignatureSize",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for an img or video tag when using the model-signature as a mask.",
      },
    },
    "styling": "jss",
  },
  "p-multi-select": {
    "controlledMeta": [
      {
        "event": "change",
        "isInternallyMutated": true,
        "props": [
          "value",
        ],
      },
    ],
    "eventsMeta": {
      "blur": {
        "description": "Emitted when the multi-select loses focus.",
        "type": "void",
      },
      "change": {
        "description": "Emitted when the user selects or deselects an option, with the updated array of values in the event detail.",
        "type": "MultiSelectChangeEventDetail",
        "typeDetail": "{ name: string; value: string[] }",
      },
      "toggle": {
        "description": "Emitted when the dropdown opens or closes, with the new open state in the event detail.",
        "type": "MultiSelectToggleEventDetail",
        "typeDetail": "{ open: boolean }",
      },
    },
    "hasAriaProp": false,
    "hasElementInternals": true,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": true,
    "isInternal": false,
    "nestedComponents": [
      "p-button-pure",
      "p-icon",
      "p-input-search",
    ],
    "propsMeta": {
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Reduces the control height and padding for a more compact layout.",
        "type": "boolean",
      },
      "description": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets a supplementary description displayed below the label to provide additional context.",
        "type": "string",
      },
      "disabled": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Disables the multi-select, preventing all interaction. Selected values are not submitted with the form.",
        "propOptions": {
          "mutable": true,
        },
        "type": "boolean",
      },
      "dropdownDirection": {
        "allowedValues": [
          "down",
          "up",
          "auto",
        ],
        "defaultValue": "auto",
        "description": "Controls whether the dropdown opens upward (\`up\`) or downward (\`down\`), or decides automatically (\`auto\`).",
        "type": "MultiSelectDropdownDirection",
      },
      "form": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Associates the multi-select with a form element by its ID when not directly nested inside it.",
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "hideLabel": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Hides the visible label while keeping it accessible to screen readers. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the visible label text displayed above the multi-select control.",
        "type": "string",
      },
      "message": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the validation feedback message displayed below the control when \`state\` is \`success\` or \`error\`.",
        "type": "string",
      },
      "name": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the name submitted with the form data to identify the selected values on the server.",
        "isRequired": true,
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "required": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Marks the multi-select as required — form submission is blocked unless at least one option is selected.",
        "type": "boolean",
      },
      "state": {
        "allowedValues": [
          "none",
          "error",
          "success",
        ],
        "defaultValue": "none",
        "description": "Sets the validation state, controlling the visual appearance and style of the feedback message (\`none\`, \`success\`, \`error\`).",
        "type": "MultiSelectState",
      },
      "value": {
        "allowedValues": "string",
        "defaultValue": [],
        "description": "Sets the array of currently selected option values. Update this to control the selection programmatically.",
        "isArray": true,
        "propOptions": {
          "mutable": true,
        },
        "type": "string[]",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for the p-multi-select-option tags.",
      },
      "description": {
        "description": "Shows a description. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "filter": {
        "description": "Optional slot for providing a custom \`p-input-search\` input. When used, the default filter input is replaced and the built-in filter logic is disabled, giving full control over filtering behavior.",
      },
      "label": {
        "description": "Shows a label. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "label-after": {
        "description": "Places additional content after the label text (for content that should not be part of the label, e.g. external links or \`p-popover\`).",
      },
      "message": {
        "description": "Shows a state message. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "options-status": {
        "description": "When implementing a custom filter with the \`filter\` slot, use this slot for loading, error and no results status.",
      },
      "selected": {
        "description": "Use this slot to provide custom markup for the selected options display in the button area.",
      },
    },
    "styling": "jss",
  },
