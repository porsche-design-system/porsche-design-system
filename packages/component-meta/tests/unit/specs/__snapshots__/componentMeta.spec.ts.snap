  "p-radio-group": {
    "eventsMeta": {
      "blur": {
        "description": "Emitted when the radio group loses focus after the user interacts with it, useful for triggering validation on blur.",
        "type": "void",
      },
      "change": {
        "description": "Emitted when the user selects a different option, carrying the new value and the native event in the event detail.",
        "type": "RadioGroupChangeEventDetail",
        "typeDetail": "Event",
      },
    },
    "hasAriaProp": false,
    "hasElementInternals": true,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": true,
    "isInternal": false,
    "nestedComponents": [
      "p-spinner",
      "p-icon",
    ],
    "propsMeta": {
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Reduces the spacing between radio options for use in dense layouts where vertical space is limited.",
        "type": "boolean",
      },
      "description": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets a supplementary description displayed below the label to give users additional guidance about the radio group.",
        "type": "string",
      },
      "direction": {
        "allowedValues": [
          "row",
          "column",
        ],
        "defaultValue": "column",
        "description": "Sets the layout direction of the radio options. Use \`column\` to stack them vertically or \`row\` to arrange them horizontally. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "RadioGroupDirection",
      },
      "disabled": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Disables all radio options in the group, preventing selection and excluding the value from form submissions.",
        "propOptions": {
          "mutable": true,
        },
        "type": "boolean",
      },
      "form": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Associates the radio group with a form element by its ID when the group is not a direct descendant of that form.",
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "hideLabel": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Hides the visible label while keeping it accessible to screen readers. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the visible label text displayed above the radio group to identify the group's purpose.",
        "type": "string",
      },
      "loading": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "@experimental Disables all radio options and shows a spinner to indicate a background loading operation.",
        "isExperimental": true,
        "type": "boolean",
      },
      "message": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the validation feedback message displayed below the radio group when \`state\` is \`success\` or \`error\`.",
        "type": "string",
      },
      "name": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the shared name attribute for all radio buttons in the group, grouping them for mutually exclusive selection.",
        "isRequired": true,
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "required": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Marks the radio group as required so the form cannot be submitted until one option is selected.",
        "type": "boolean",
      },
      "state": {
        "allowedValues": [
          "none",
          "error",
          "success",
        ],
        "defaultValue": "none",
        "description": "Sets the validation state of the radio group, controlling its visual appearance and feedback message style (\`none\`, \`success\`, \`error\`).",
        "type": "RadioGroupState",
      },
      "value": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the currently selected value that pre-selects the matching radio option and reflects user changes.",
        "propOptions": {
          "mutable": true,
        },
        "type": "string",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for the p-radio-group-option tags.",
      },
      "description": {
        "description": "Shows a description. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "label": {
        "description": "Shows a label. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "label-after": {
        "description": "Places additional content after the label text (for content that should not be part of the label, e.g. external links or \`p-popover\`).",
      },
      "message": {
        "description": "Shows a state message. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
    },
    "styling": "jss",
  },
