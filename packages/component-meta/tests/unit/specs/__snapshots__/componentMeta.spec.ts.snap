  "p-sheet": {
    "controlledMeta": [
      {
        "event": "dismiss",
        "props": [
          "open",
        ],
      },
    ],
    "cssVariablesMeta": {
      "--ref-p-sheet-pb": {
        "description": "Exposes the internally used padding-bottom of the Sheet as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the bottom of the Sheet.",
      },
      "--ref-p-sheet-pt": {
        "description": "Exposes the internally used padding-top of the Sheet as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the top of the Sheet.",
      },
      "--ref-p-sheet-px": {
        "description": "Exposes the internally used padding-inline of the Sheet as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the full horizontal size of the Sheet.",
      },
    },
    "eventsMeta": {
      "dismiss": {
        "description": "Emitted when the user dismisses the sheet via the close button, backdrop click, or Escape key.",
        "type": "void",
      },
      "motionHiddenEnd": {
        "description": "Emitted after the sheet's close transition has fully completed and the panel is hidden.",
        "type": "SheetMotionHiddenEndEventDetail",
        "typeDetail": "TransitionEvent",
      },
      "motionVisibleEnd": {
        "description": "Emitted after the sheet's open transition has fully completed and the panel is visible.",
        "type": "SheetMotionVisibleEndEventDetail",
        "typeDetail": "TransitionEvent",
      },
    },
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
