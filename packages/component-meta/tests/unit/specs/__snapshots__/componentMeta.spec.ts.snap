      "description": {
        "description": "Deprecated: Use the default slot instead.",
        "isDeprecated": true,
      },
      "heading": {
        "description": "Defines the heading of the banner. Can be used as an alternative to the \`heading\` prop for rich content.",
      },
    },
    "styling": "jss",
  },
