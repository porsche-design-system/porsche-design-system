{
  "p-accordion": {
    "controlledMeta": [
      {
        "event": "update",
        "props": [
          "open",
        ],
      },
    ],
    "cssVariablesMeta": {
      "--p-accordion-px": {
        "defaultValue": "16px",
        "description": "Horizontal padding of the accordion.",
      },
      "--p-accordion-py": {
        "defaultValue": "16px",
        "description": "Vertical padding of the accordion.",
      },
      "--p-accordion-summary-top": {
        "defaultValue": "0px",
        "description": "Controls the sticky top position when \`sticky\` is enabled.",
      },
    },
    "eventsMeta": {
      "update": {
        "description": "Emitted when the user toggles the accordion open or closed, with the new open state in the event detail.",
        "type": "AccordionUpdateEventDetail",
        "typeDetail": "{ open: boolean }",
      },
    },
    "hasAriaProp": false,
    "hasElementInternals": false,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": true,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": true,
    "isInternal": false,
    "propsMeta": {
      "alignMarker": {
        "allowedValues": [
          "start",
          "end",
        ],
        "defaultValue": "end",
        "description": "Positions the expand/collapse marker icon at the start or end of the summary section.",
        "type": "AccordionAlignMarker",
      },
      "background": {
        "allowedValues": [
          "canvas",
          "surface",
          "frosted",
          "none",
        ],
        "defaultValue": "none",
        "description": "Sets the background color of the accordion panel. Use \`frosted\` only when placed on images, videos, or gradients.",
        "type": "AccordionBackground",
      },
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": null,
        "description": "Reduces padding and spacing for a more compact layout, useful in space-constrained interfaces.",
        "type": "boolean",
      },
      "heading": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "@deprecated Will be removed in the next major release. Use the \`summary\` slot instead. Sets the heading text within the summary section.",
        "isDeprecated": true,
        "type": "string",
      },
      "headingTag": {
        "allowedValues": [
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6",
        ],
        "defaultValue": "h2",
        "description": "@deprecated Will be removed in the next major release. Use the \`summary\` slot instead. Sets the heading tag for proper semantic structure within the page.",
        "isDeprecated": true,
        "type": "AccordionHeadingTag",
      },
      "open": {
        "allowedValues": "boolean",
        "defaultValue": null,
        "description": "Controls whether the accordion is open or closed.",
        "type": "boolean",
      },
      "size": {
        "allowedValues": [
          "small",
          "medium",
        ],
        "defaultValue": "small",
        "description": "@deprecated Will be removed in the next major release. Use the \`summary\` slot instead. Controls the heading size in the summary section (only applies when using the \`heading\` prop or \`heading\` slot).",
        "isBreakpointCustomizable": true,
        "isDeprecated": true,
        "type": "AccordionSize",
      },
      "sticky": {
        "allowedValues": "boolean",
        "defaultValue": null,
        "description": "@experimental Makes the summary section sticky at the top while scrolling. Only works with \`background="canvas"\` or \`background="surface"\`. Not compatible with \`summary-before\` or \`summary-after\` slots.",
        "isExperimental": true,
        "type": "boolean",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Main content displayed when the accordion is expanded.",
      },
      "heading": {
        "description": "Content for the accordion's heading section. Clicking toggles the accordion open and closed.",
        "isDeprecated": true,
      },
      "summary": {
        "description": "Content for the accordion's summary section. Clicking toggles the accordion open and closed.",
      },
      "summary-after": {
        "description": "Content or interactive elements placed after the accordion's summary section.",
      },
      "summary-before": {
        "description": "Content or interactive elements placed before the accordion's summary section.",
      },
    },
    "styling": "jss",
  },
  "p-banner": {
    "controlledMeta": [
      {
        "event": "dismiss",
        "props": [
          "open",
        ],
      },
    ],
    "cssVariablesMeta": {
      "--p-banner-bottom": {
        "defaultValue": "56px",
        "description": "Defines the distance from the bottom of the viewport. Only takes effect when the \`position\` property is set to \`bottom\` (at the respective breakpoint).",
      },
      "--p-banner-inset-x": {
        "defaultValue": "max(22px, 10.625vw - 12px)",
        "description": "Defines the horizontal offset of the Banner from the edges of the viewport.",
      },
      "--p-banner-max-w": {
        "defaultValue": "100ch",
        "description": "Defines the maximum width of the Banner.",
      },
      "--p-banner-top": {
        "defaultValue": "56px",
        "description": "Defines the distance from the top of the viewport. Only takes effect when the \`position\` property is set to \`top\` (at the respective breakpoint).",
      },
    },
    "eventsMeta": {
      "dismiss": {
        "description": "Emitted when the user closes the banner via the dismiss button or Escape key.",
        "type": "void",
      },
    },
    "hasAriaProp": false,
    "hasElementInternals": false,
    "hasEvent": true,
    "hasObserveAttributes": false,
