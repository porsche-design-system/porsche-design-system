    "isDelegatingFocus": true,
    "isExperimental": true,
    "isInternal": false,
    "propsMeta": {
      "active": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Visually marks the link as the currently active navigation item, e.g. the current page.",
        "type": "boolean",
      },
      "aria": {
        "allowedValues": {
          "aria-current": "string",
          "aria-description": "string",
          "aria-haspopup": "string",
          "aria-label": "string",
        },
        "defaultValue": null,
        "description": "Sets ARIA attributes on the link for improved accessibility. Only applies when \`href\` is set.",
        "isAria": true,
        "type": "DrilldownLinkAriaAttribute",
      },
      "download": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the native \`download\` attribute to trigger a file download. Only applies when \`href\` is set.",
        "type": "string",
      },
      "href": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "When set, the component renders as an anchor navigating to this URL. Otherwise, provide a slotted anchor element.",
        "type": "string",
      },
      "rel": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the \`rel\` attribute on the link element (e.g. \`noopener\`). Only applies when \`href\` is set.",
        "type": "string",
      },
      "target": {
        "allowedValues": [
          "_self",
          "_blank",
          "_parent",
          "_top",
          "string",
        ],
        "defaultValue": "_self",
        "description": "Specifies where to open the linked URL (e.g. \`_self\`, \`_blank\`). Only applies when \`href\` is set.",
        "type": "DrilldownLinkTarget",
      },
    },
    "requiredParent": [
      "p-drilldown",
      "p-drilldown-item",
    ],
    "slotsMeta": {
      "": {
        "description": "Default slot to render the link label.",
      },
    },
    "styling": "jss",
  },
