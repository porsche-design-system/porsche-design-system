  },
  "p-flyout": {
    "controlledMeta": [
      {
        "event": "dismiss",
        "props": [
          "open",
        ],
      },
    ],
    "cssVariablesMeta": {
      "--p-flyout-sticky-top": {
        "description": "@experimental Exposes the header's height as a read-only CSS variable, set automatically by the component. Slotted sticky content can use this value to offset their top position correctly.",
      },
      "--p-flyout-width": {
        "defaultValue": "auto",
        "description": "Width of the flyout.",
      },
      "--ref-p-flyout-pb": {
        "description": "Exposes the internally used padding-bottom of the Flyout as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the bottom of the Flyout.",
      },
      "--ref-p-flyout-pt": {
        "description": "Exposes the internally used padding-top of the Flyout as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the top of the Flyout.",
      },
      "--ref-p-flyout-px": {
        "description": "Exposes the internally used padding-inline of the Flyout as read only CSS variable. When slotting e.g. a media container, this variable can be used to stretch the element to the full horizontal size of the Flyout.",
      },
    },
    "eventsMeta": {
      "dismiss": {
        "description": "Emitted when the user closes the flyout via the close button, backdrop click, or Escape key.",
        "type": "void",
      },
      "motionHiddenEnd": {
        "description": "Emitted after the flyout's close transition completes and the panel is fully hidden.",
        "type": "FlyoutMotionHiddenEndEventDetail",
        "typeDetail": "TransitionEvent",
      },
      "motionVisibleEnd": {
        "description": "Emitted after the flyout's open transition completes and the panel is fully visible.",
        "type": "FlyoutMotionVisibleEndEventDetail",
        "typeDetail": "TransitionEvent",
      },
    },
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": true,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": false,
    "isInternal": false,
    "nestedComponents": [
      "p-button",
    ],
    "propsMeta": {
      "aria": {
        "allowedValues": {
          "aria-label": "string",
        },
        "defaultValue": null,
        "description": "Sets ARIA attributes on the flyout dialog element for improved screen reader accessibility.",
        "isAria": true,
        "type": "FlyoutAriaAttribute",
      },
      "backdrop": {
        "allowedValues": [
          "blur",
          "shading",
        ],
        "defaultValue": "blur",
        "description": "Sets the backdrop style. Use \`blur\` when background content is irrelevant; use \`shading\` when users still need visual context.",
        "type": "FlyoutBackdrop",
      },
      "background": {
        "allowedValues": [
          "canvas",
          "surface",
        ],
        "defaultValue": "canvas",
        "description": "Sets the background color of the flyout panel (\`canvas\` or \`surface\`).",
        "type": "FlyoutBackground",
      },
      "disableBackdropClick": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "When enabled, clicking the backdrop will not close the flyout — users must use the close button.",
        "type": "boolean",
      },
      "footerBehavior": {
        "allowedValues": [
          "sticky",
          "fixed",
        ],
        "defaultValue": "sticky",
        "description": "Controls footer behavior. \`fixed\` keeps it anchored at the bottom; \`sticky\` pins it only when content overflows.",
        "type": "FlyoutFooterBehavior",
      },
      "open": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Controls whether the flyout panel is visible.",
        "isRequired": true,
        "type": "boolean",
      },
      "position": {
        "allowedValues": [
          "start",
          "end",
        ],
        "defaultValue": "end",
        "description": "Sets the side the flyout slides in from — \`start\` for left or \`end\` for right in LTR layouts.",
        "type": "FlyoutPosition",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for the main content.",
      },
      "footer": {
        "description": "Shows a sticky footer section, flowing under the content area when scrollable.",
      },
      "header": {
        "description": "Renders a sticky header section above the content area.",
      },
      "sub-footer": {
        "description": "Renders additional content below the footer, such as legal information or FAQs. It appears when the flyout has enough space or when the user scrolls to the end.",
      },
    },
    "styling": "jss",
  },
  "p-heading": {
    "hasAriaProp": false,
    "hasElementInternals": false,
    "hasEvent": false,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": false,
    "isInternal": false,
    "propsMeta": {
      "align": {
        "allowedValues": [
          "start",
          "center",
          "end",
          "inherit",
        ],
        "defaultValue": "start",
        "description": "Sets the horizontal text alignment (\`start\`, \`center\`, \`end\`, or \`inherit\`).",
        "type": "HeadingAlign",
      },
      "color": {
        "allowedValues": [
          "primary",
          "contrast-higher",
          "contrast-high",
          "contrast-medium",
          "inherit",
        ],
        "defaultValue": "primary",
        "description": "Sets the text color using PDS color tokens.",
        "type": "HeadingColor",
      },
      "ellipsis": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Truncates the text with an ellipsis when it overflows the container on a single line. Cannot be combined with multi-line content.",
        "type": "boolean",
      },
      "hyphens": {
        "allowedValues": [
          "none",
          "manual",
          "auto",
          "inherit",
        ],
        "defaultValue": "none",
        "description": "Controls hyphenation behavior — \`auto\` lets the browser decide, \`manual\` only breaks at \`&shy;\`, \`none\` disables it entirely.",
        "type": "HeadingHyphens",
      },
      "size": {
        "allowedValues": [
          "2xs",
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "2xl",
          "3xl",
          "4xl",
          "5xl",
          "inherit",
          "small",
          "medium",
          "large",
          "x-large",
          "xx-large",
        ],
        "defaultValue": "2xl",
        "deprecatedValues": [
          "small",
          "medium",
          "large",
          "x-large",
          "xx-large",
        ],
        "description": "Sets the visual size of the heading. Use \`inherit\` to derive size from the parent. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "HeadingSize",
      },
      "tag": {
        "allowedValues": [
          null,
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6",
        ],
        "defaultValue": null,
        "description": "Sets the HTML heading tag (h1–h6) for correct document outline placement. When omitted, the tag is inferred from \`size\`.",
        "type": "HeadingTag",
      },
      "weight": {
        "allowedValues": [
          "normal",
          "semibold",
          "bold",
          "regular",
          "semi-bold",
        ],
        "defaultValue": "normal",
        "deprecatedValues": [
          "regular",
          "semi-bold",
        ],
        "description": "Sets the font weight — \`normal\`, \`semibold\`, or \`bold\`.",
        "type": "HeadingWeight",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot to render the heading.",
      },
    },
    "styling": "jss",
  },
