        "allowedValues": {
          "aria-label": "string",
          "role": "string",
        },
        "defaultValue": null,
        "description": "Sets ARIA attributes on the sheet dialog element for improved accessibility when the default \`aria-label\` is insufficient.",
        "isAria": true,
        "type": "SheetAriaAttribute",
      },
      "background": {
        "allowedValues": [
          "canvas",
          "surface",
        ],
        "defaultValue": "canvas",
        "description": "Sets the background color of the sheet panel (\`canvas\` or \`surface\`).",
        "type": "SheetBackground",
      },
      "disableBackdropClick": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "When enabled, clicking the backdrop behind the sheet will not close it, forcing explicit dismissal via the close button.",
        "type": "boolean",
      },
      "dismissButton": {
        "allowedValues": "boolean",
        "defaultValue": true,
        "description": "Shows a dismiss button in the sheet header so users can manually close it.",
        "type": "boolean",
      },
      "open": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Controls whether the sheet panel slides in from the bottom and is visible to the user.",
        "isRequired": true,
        "type": "boolean",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot for the main content.",
      },
      "header": {
        "description": "Renders a header section above the content area.",
      },
    },
    "styling": "jss",
  },
