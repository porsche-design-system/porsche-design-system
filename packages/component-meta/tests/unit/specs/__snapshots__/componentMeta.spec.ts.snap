    "propsMeta": {
      "autoComplete": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Provides the browser with a hint to enable text autofill suggestions for the textarea (e.g. \`autocomplete='on'\`).",
        "type": "string",
      },
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Reduces the textarea's initial height and padding for use in dense layouts where vertical space is limited.",
        "type": "boolean",
      },
      "counter": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Shows a live character counter below the textarea indicating how many characters the user has typed relative to \`maxLength\`.",
        "type": "boolean",
      },
      "description": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets a supplementary description displayed below the label to give users additional guidance about the textarea.",
        "type": "string",
      },
      "disabled": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Prevents user interaction with the textarea and excludes its value from form submissions.",
        "propOptions": {
          "mutable": true,
        },
        "type": "boolean",
      },
      "form": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Associates the textarea with a form element by its ID when the textarea is not a direct descendant of that form.",
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "hideLabel": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Hides the visible label while keeping it accessible to screen readers. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the visible label text displayed above the textarea to identify its purpose.",
        "type": "string",
      },
      "maxLength": {
        "allowedValues": "number",
        "defaultValue": null,
        "description": "Sets the maximum number of characters the user is allowed to enter into the textarea.",
        "type": "number",
      },
      "message": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the validation feedback message displayed below the textarea when \`state\` is \`success\` or \`error\`.",
        "type": "string",
      },
      "minLength": {
        "allowedValues": "number",
        "defaultValue": null,
        "description": "Sets the minimum number of characters required for the textarea's value to pass constraint validation.",
        "type": "number",
      },
      "name": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the name of the textarea submitted with the form data to identify this field's value on the server.",
        "isRequired": true,
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "placeholder": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets placeholder text displayed inside the textarea when it is empty to hint at the expected content format.",
        "type": "string",
      },
      "readOnly": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Makes the textarea read-only so users cannot modify the value, while still including it in form submissions.",
        "type": "boolean",
      },
      "required": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Marks the textarea as required so the form cannot be submitted while this field is empty.",
        "type": "boolean",
      },
      "resize": {
        "allowedValues": [
          "none",
          "both",
          "horizontal",
          "vertical",
          "block",
          "inline",
        ],
        "defaultValue": "vertical",
        "description": "Controls whether and in which direction the user can resize the textarea (\`horizontal\`, \`vertical\`, \`both\`, or \`none\`).",
        "type": "TextareaResize",
      },
      "rows": {
        "allowedValues": "number",
        "defaultValue": 7,
        "description": "Sets the initial visible height of the textarea in lines of text. Has no effect when the \`--p-textarea-field-sizing\` CSS variable is set to \`content\`.",
        "type": "number",
      },
      "spellCheck": {
        "allowedValues": "boolean",
        "defaultValue": null,
        "description": "Controls whether the browser's built-in spell-checking and grammar checking is enabled for the textarea content.",
        "type": "boolean",
      },
      "state": {
        "allowedValues": [
          "none",
          "error",
          "success",
        ],
        "defaultValue": "none",
        "description": "Sets the validation state of the textarea, which controls its visual appearance and feedback message style (\`none\`, \`success\`, \`error\`).",
        "type": "TextareaState",
      },
      "value": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the current multi-line text value of the textarea and reflects any changes made by the user.",
        "propOptions": {
          "mutable": true,
        },
        "type": "string",
      },
      "wrap": {
        "allowedValues": [
          "hard",
          "soft",
          "off",
        ],
        "defaultValue": "soft",
        "description": "Controls how the submitted text wraps in the form data: \`soft\` wraps only visually, \`hard\` inserts line breaks at the textarea width.",
        "type": "TextareaWrap",
      },
    },
    "slotsMeta": {
      "description": {
        "description": "Shows a description. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "label": {
        "description": "Shows a label. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
      "label-after": {
        "description": "Places additional content after the label text (for content that should not be part of the label, e.g. external links or \`p-popover\`).",
      },
      "message": {
        "description": "Shows a state message. Only [phrasing content](https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/Content_categories#Phrasing_content) is allowed.",
      },
    },
    "styling": "jss",
  },
  "p-toast": {
    "cssVariablesMeta": {
      "--p-toast-position-bottom": {
        "defaultValue": "56px",
        "description": "Defines the spacing between the toast and the bottom edge of its container.",
