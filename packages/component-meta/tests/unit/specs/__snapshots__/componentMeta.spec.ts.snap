  "p-drilldown": {
    "controlledMeta": [
      {
        "event": "dismiss",
        "props": [
          "open",
        ],
      },
      {
        "event": "update",
        "props": [
          "activeIdentifier",
        ],
      },
    ],
    "cssVariablesMeta": {
      "--p-drilldown-gap": {
        "defaultValue": "8px",
        "description": "Overrides the gap between drilldown items in the default slot container.",
      },
      "--p-drilldown-grid-template": {
        "defaultValue": "auto/auto",
        "description": "Overrides the CSS \`grid-template\` of the default slot container, allowing custom grid layout for drilldown items.",
      },
    },
    "eventsMeta": {
      "dismiss": {
        "description": "Emitted when the user closes the drilldown via the close button or Escape key.",
        "type": "void",
      },
      "update": {
        "description": "Emitted when the active navigation level changes, with the new \`activeIdentifier\` in the event detail.",
        "type": "DrilldownUpdateEventDetail",
        "typeDetail": "{ activeIdentifier: string | undefined }",
      },
    },
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": false,
    "isExperimental": true,
    "isInternal": false,
    "nestedComponents": [
      "p-button-pure",
      "p-button",
    ],
    "propsMeta": {
      "activeIdentifier": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets which \`p-drilldown-item\` (by \`identifier\`) is currently expanded to show its sub-navigation level.",
        "type": "string | undefined",
      },
      "aria": {
        "allowedValues": {
          "aria-label": "string",
        },
        "defaultValue": null,
        "description": "Sets ARIA attributes on the drilldown dialog element for improved screen reader accessibility.",
        "isAria": true,
        "type": "DrilldownAriaAttribute",
      },
      "open": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Controls whether the drilldown navigation panel is visible.",
        "type": "boolean",
      },
    },
    "slotsMeta": {
      "": {
        "description": "Default slot to render p-drilldown items.",
      },
    },
    "styling": "jss",
  },
  "p-drilldown-item": {
    "hasAriaProp": false,
    "hasElementInternals": false,
    "hasEvent": false,
    "hasObserveAttributes": false,
    "hasObserveChildren": true,
    "hasSlot": true,
    "isChunked": false,
    "isDelegatingFocus": false,
    "isExperimental": true,
    "isInternal": false,
    "nestedComponents": [
      "p-button-pure",
    ],
    "propsMeta": {
      "cascade": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Private property set by the component itself.",
        "propOptions": {
          "mutable": true,
          "reflect": true,
        },
        "type": "boolean",
      },
      "identifier": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the unique identifier matched against the drilldown's \`activeIdentifier\` to determine if this item is shown.",
        "isRequired": true,
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the text used for the back button, sticky header, and cascade button that navigates into this navigation level.",
        "type": "string",
      },
      "primary": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Private property set by the component itself.",
        "propOptions": {
          "mutable": true,
          "reflect": true,
        },
        "type": "boolean",
      },
      "secondary": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Private property set by the component itself.",
        "propOptions": {
          "mutable": true,
          "reflect": true,
        },
        "type": "boolean",
      },
    },
    "requiredParent": [
      "p-drilldown",
      "p-drilldown-item",
    ],
    "slotsMeta": {
      "": {
        "description": "Default slot for the main content.",
      },
      "button": {
        "description": "Shows a custom button to reach a deeper level of the navigation structure.",
      },
      "header": {
        "description": "Shows a custom header section on mobile view.",
      },
    },
    "styling": "jss",
  },
  "p-drilldown-link": {
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": false,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
