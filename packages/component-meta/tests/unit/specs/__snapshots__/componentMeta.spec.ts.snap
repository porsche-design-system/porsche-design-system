        "type": "boolean",
      },
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Reduces the switch size and spacing for use in dense layouts where vertical space is limited.",
        "type": "boolean",
      },
      "disabled": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Prevents user interaction with the switch and blocks all click and keyboard events while it is disabled.",
        "type": "boolean",
      },
      "hideLabel": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Hides the visible label while keeping it accessible to screen readers. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "loading": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Disables the switch and shows a loading spinner to indicate an ongoing asynchronous toggle operation.",
        "type": "boolean",
      },
      "stretch": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Expands the space between the switch toggle and its label to fill the full available width of the container. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
