  },
  "p-wordmark": {
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": false,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": false,
    "isChunked": true,
    "isDelegatingFocus": true,
    "isInternal": false,
    "propsMeta": {
      "aria": {
        "allowedValues": {
          "aria-current": "string",
          "aria-description": "string",
          "aria-haspopup": "string",
          "aria-label": "string",
        },
        "defaultValue": null,
        "description": "Sets ARIA attributes on the anchor element to improve accessibility when the wordmark is used as a link.",
        "isAria": true,
        "type": "WordmarkAriaAttribute",
      },
      "href": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "When set, wraps the wordmark in an anchor element that navigates to the given URL on click.",
        "type": "string",
      },
      "size": {
        "allowedValues": [
          "small",
          "inherit",
        ],
        "defaultValue": "small",
        "description": "Sets the display size of the Porsche wordmark SVG using predefined PDS size tokens (\`small\`, \`medium\`, \`large\`, \`inherit\`).",
        "type": "WordmarkSize",
      },
      "target": {
        "allowedValues": [
          "_self",
          "_blank",
          "_parent",
          "_top",
          "string",
        ],
        "defaultValue": "_self",
        "description": "Specifies where to open the linked URL when \`href\` is set (e.g. \`_self\`, \`_blank\`).",
        "type": "WordmarkTarget",
      },
    },
    "styling": "jss",
  },
}
