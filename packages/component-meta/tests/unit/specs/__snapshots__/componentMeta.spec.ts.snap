        "defaultValue": "auto",
        "description": "Sets the number of equal-width columns for the item layout. Use \`auto\` to distribute items based on their content width. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "SegmentedControlColumns",
      },
      "compact": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Reduces the item height and spacing for use in dense layouts where vertical space is limited.",
        "type": "boolean",
      },
      "description": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets a supplementary description displayed below the label to give users additional context about the segmented control.",
        "type": "string",
      },
      "disabled": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Prevents user interaction with all items in the segmented control and excludes the value from form submissions.",
        "propOptions": {
          "mutable": true,
        },
        "type": "boolean",
      },
      "form": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Associates the segmented control with a form element by its ID when it is not a direct descendant of that form.",
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "hideLabel": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Hides the visible label while keeping it accessible to screen readers. Supports responsive breakpoint values.",
        "isBreakpointCustomizable": true,
        "type": "boolean",
      },
      "label": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the visible label text displayed above the segmented control to describe the group of options.",
        "type": "string",
      },
      "message": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "Sets the validation feedback message displayed below the segmented control when \`state\` is \`success\` or \`error\`.",
        "type": "string",
      },
      "name": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Sets the name of the control submitted with the form data to identify the selected value on the server.",
        "propOptions": {
          "reflect": true,
        },
        "type": "string",
      },
      "noWrap": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Prevents items from wrapping to new rows and renders them in a single horizontally scrollable row instead.",
        "type": "boolean",
      },
      "required": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "Marks the segmented control as required so the form cannot be submitted until one option is selected.",
        "type": "boolean",
      },
      "state": {
        "allowedValues": [
          "none",
          "error",
          "success",
        ],
        "defaultValue": "none",
        "description": "Sets the validation state of the segmented control, controlling its visual appearance and feedback message style (\`none\`, \`success\`, \`error\`).",
        "type": "SegmentedControlState",
      },
      "value": {
        "allowedValues": [
          "string",
