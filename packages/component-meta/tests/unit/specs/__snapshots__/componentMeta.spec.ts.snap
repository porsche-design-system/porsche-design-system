        "defaultValue": "info",
        "description": "Sets the visual and semantic state of the toast item, controlling its icon and color scheme (\`info\`, \`warning\`, \`error\`, \`success\`).",
        "type": "ToastState",
      },
      "text": {
        "defaultValue": "",
        "description": "Sets the notification message text displayed inside the toast item to inform the user about the outcome of an action.",
        "type": "string",
      },
