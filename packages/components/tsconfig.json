{
  "extends": "shared/src/tsconfig.json",
  "compilerOptions": {
    "useDefineForClassFields": false,
    "strict": false,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "experimentalDecorators": true,
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["./tests", "**/*.spec.ts"]
}
