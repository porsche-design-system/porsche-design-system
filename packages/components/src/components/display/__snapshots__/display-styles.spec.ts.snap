exports[`getComponentCss() > should return correct css for size: {"base":"medium","xs":"large","s":"medium","m":"inherit","l":"large","xl":"medium"}, align: center, color: primary and ellipsis: true 1`] = `
":host {
  display: block;
}
:host([hidden]) {
  display: none !important;
}
::slotted(:is(h1,h2,h3,h4,h5,h6)) {
  all: unset !important;
}
.root {
  all: unset;
  display: block;
  font: var(--p-font-weight-normal) var(--p-typescale-5xl)/var(--p-leading-normal) var(--p-font-porsche-next);
  font-size: var(--p-typescale-4xl);
  color: var(--p-color-primary);
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
@media(min-width:480px) {
  .root {
    font-size: var(--p-typescale-5xl);
  }
}

@media(min-width:760px) {
  .root {
    font-size: var(--p-typescale-4xl);
  }
}

@media(min-width:1000px) {
  .root {
    font-size: inherit;
  }
}

@media(min-width:1300px) {
  .root {
    font-size: var(--p-typescale-5xl);
  }
}

@media(min-width:1760px) {
  .root {
    font-size: var(--p-typescale-4xl);
  }
}"
`;
