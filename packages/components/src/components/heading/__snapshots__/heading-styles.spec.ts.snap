exports[`getComponentCss() > should return correct css for size: {"base":"sm","xs":"md","s":"lg","m":"xl","l":"2xl","xl":"lg"}, align: normal, color: end, hyphens: inherit, and ellipsis: none 1`] = `
":host {
  display: block;
}
:host([hidden]) {
  display: none !important;
}
::slotted(:is(h1,h2,h3,h4,h5,h6)) {
  all: unset;
}
.root {
  all: unset;
  display: block;
  font: var(--p-font-weight-normal) var(--p-typescale-2xl)/var(--p-leading-normal) var(--p-font-porsche-next);
  font-size: var(--p-typescale-sm);
  color: currentcolor;
  text-align: end;
  hyphens: none;
}
@media(min-width:480px) {
  .root {
    font-size: var(--p-typescale-md);
  }
}

@media(min-width:760px) {
  .root {
    font-size: var(--p-typescale-lg);
  }
}

@media(min-width:1000px) {
  .root {
    font-size: var(--p-typescale-xl);
  }
}

@media(min-width:1300px) {
  .root {
    font-size: var(--p-typescale-2xl);
  }
}

@media(min-width:1760px) {
  .root {
    font-size: var(--p-typescale-lg);
  }
}
"
`;
