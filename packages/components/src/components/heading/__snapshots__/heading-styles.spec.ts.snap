exports[`getComponentCss() > should return correct css for size: "2xl", align: normal, color: start, hyphens: primary, and ellipsis: none 1`] = `
":host {
  display: block;
}
:host([hidden]) {
  display: none !important;
}
::slotted(:is(h1,h2,h3,h4,h5,h6)) {
  all: unset;
}
.root {
  all: unset;
  display: block;
  font: var(--p-font-weight-normal) var(--p-typescale-2xl)/var(--p-leading-normal) var(--p-font-porsche-next);
  font-size: var(--p-typescale-2xl);
  color: var(--p-color-primary);
  text-align: start;
  hyphens: none;
}"
`;

