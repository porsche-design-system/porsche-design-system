// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`getComponentCss() > should return correct css for disabled: false, loading: false and state: error 1`] = `
":host {
  display: block;
}
:host([hidden]) {
  display: none !important;
}
slot[name="label-after"] {
  display: inline-block;
  vertical-align: top;
}
slot[name="label-after"]::slotted(*) {
  margin-inline-start: var(--p-spacing-static-xs) !important;
}
:not(:defined,[data-ssr]) {
  visibility: hidden;
}
input {
  all: unset;
  display: grid;
  width: calc(var(--p-internal-radio-group-option-scaling) * 1.75rem);
  height: calc(var(--p-internal-radio-group-option-scaling) * 1.75rem);
  margin-block: max(0px, calc((var(--p-leading-normal) - calc(var(--p-internal-radio-group-option-scaling) * 1.75rem)) / 2));
  box-sizing: border-box;
  font: var(--p-typescale-sm) var(--p-font-porsche-next);
  background: var(--p-color-error-frosted-soft);
  transition: background-color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out), border-color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  border: 1px solid var(--p-color-error);
  border-radius: var(--p-radius-full);
}
input:focus-visible {
  outline: 2px solid var(--p-color-focus);
  outline-offset: 2px;
}
input:checked {
  background: var(--p-color-error);
}
input::before {
  content: "";
  grid-area: 1/1;
}
input::after {
  content: "";
  margin: calc(-1px - max(0px, calc(24px - calc(var(--p-internal-radio-group-option-scaling) * 1.75rem)) / 2));
  grid-area: 1/1;
}
input:checked::before {
  -webkit-mask: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/></svg>') center/contain no-repeat;
  mask: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/></svg>') center/contain no-repeat;
  background-color: var(--p-color-canvas);
}
@media(forced-colors:active) {
  input:checked::before {
    background: CanvasText;
  }
  input:focus-visible {
    outline-color: Highlight;
  }
}

@media(hover:hover) {
  input:hover {
    border-color: var(--p-color-error);
  }
}

.root {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  row-gap: var(--p-spacing-static-xs);
}
.wrapper {
  position: relative;
  display: flex;
  align-items: center;
  align-self: flex-start;
  min-height: var(--p-leading-normal);
  cursor: pointer;
}
.label-wrapper {
  min-width: fit-content;
  position: static;
  width: auto;
  height: auto;
  padding: 0;
  margin: 0;
  overflow: visible;
  clip: auto;
  white-space: normal;
  padding-top: max(0px, calc((calc(var(--p-internal-radio-group-option-scaling) * 1.75rem) - var(--p-leading-normal)) / 2));
  padding-inline-start: calc(11.2px * (var(--p-internal-radio-group-option-scaling) - 0.64285714) + 4px);
}
.label {
  font: var(--p-font-weight-normal) var(--p-typescale-sm) / var(--p-leading-normal) var(--p-font-porsche-next);
  cursor: pointer;
  color: var(--p-color-primary);
  transition: color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  display: inline;
}
.label:empty {
  display: none;
}
.label:is(span) {
  cursor: unset;
  font-size: var(--p-typescale-xs);
  color: var(--p-color-contrast-high);
  position: static;
  width: auto;
  height: auto;
  padding: 0;
  margin: 0;
  overflow: visible;
  clip: auto;
  white-space: normal;
  margin-top: calc(-1 * var(--p-spacing-static-xs));
}
.label > slot[name="label"]::slotted(*) {
  display: inline !important;
}
.required {
  user-select: none;
}
.loading {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
}"
`;

