// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`getComponentCss() > should return correct css 1`] = `
"@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
  :host {
    position: relative;
    display: inline-block;
    vertical-align: top;
  }
  :host([hidden]) {
    display: none !important;
  }
  slot[name="button"] {
    display: block;
  }
  :not(:defined,[data-ssr]) {
    visibility: hidden;
  }
  p {
    font: var(--p-font-weight-normal) var(--p-typescale-sm)/var(--p-leading-normal) var(--p-font-porsche-next);
    margin: 0;
  }
  button {
    all: unset;
    display: block;
    font: var(--p-typescale-sm) var(--p-font-porsche-next);
    width: var(--p-leading-normal);
    height: var(--p-leading-normal);
    border-radius: var(--p-radius-full);
    cursor: pointer;
    background-color: var(--p-color-frosted);
    transition: background-color var(--p-transition-duration,var(--p-duration-sm)) var(--p-ease-in-out);
    -webkit-backdrop-filter: var(--p-blur-frosted);
    backdrop-filter: var(--p-blur-frosted);
  }
  button:focus-visible {
    outline: 2px solid var(--p-color-focus);
    outline-offset: 2px;
  }
  [popover] {
    all: unset;
    position: absolute;
    pointer-events: none;
    filter: drop-shadow(0 0 16px rgba(0,0,0,0.3));
    backdrop-filter: drop-shadow(0 0 transparent);
    animation: var(--p-animation-duration,var(--p-duration-sm)) fade-in var(--p-ease-in-out) forwards;
  }
  [popover]:not(:popover-open) {
    display: none;
  }
@media(hover:hover) {
    button:hover {
      background-color: var(--p-color-frosted-soft);
    }
}

@media(forced-colors:active) {
    button:focus-visible {
      outline-color: Highlight;
    }
}

  .label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }
  .icon {
    transform: translate3d(0,0,0);
  }
  .arrow {
    position: absolute;
    width: 24px;
    height: 12px;
    clip-path: polygon(50% 0, 100% 110%, 0 110%);
    background: var(--p-color-canvas);
  }
  .content {
    max-width: min(calc(100dvw - 16px), 48ch);
    width: max-content;
    box-sizing: border-box;
    padding: var(--p-spacing-static-sm) var(--p-spacing-static-md);
    pointer-events: auto;
    border-radius: var(--p-radius-xl);
    background: var(--p-color-canvas);
    font: var(--p-font-weight-normal) var(--p-typescale-sm)/var(--p-leading-normal) var(--p-font-porsche-next);
    color: var(--p-color-primary);
  }
@media(forced-colors:active) {
    .arrow {
      background: CanvasText;
    }
    .content {
      outline: 2px solid CanvasText;
      outline-offset: -2px;
    }
}"
`;
