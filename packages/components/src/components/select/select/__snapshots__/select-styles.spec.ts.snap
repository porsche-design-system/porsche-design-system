    display: flex;
    align-items: center;
    gap: calc(22.4px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    height: calc(var(--p-internal-select-scaling) * 3.5rem);
    box-sizing: border-box;
    min-width: 0;
    padding-inline: calc(22.4px * (var(--p-internal-select-scaling) - 0.64285714) + 8px);
    border: 1px solid var(--p-select-border-color, var(--p-color-primary));
    border-radius: var(--_p-legacy-radius-small, var(--p-radius-xl));
    background: var(--p-select-background-color, var(--p-color-frosted));
    font: var(--p-font-weight-normal) var(--p-typescale-sm) / var(--p-leading-normal) var(--p-font-porsche-next);
    color: var(--p-select-text-color, var(--p-color-primary));
    cursor: not-allowed;
    opacity: 0.4;
    transition: background-color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out), border-color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out), color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  }
  button img {
    font: var(--p-typescale-sm) var(--p-font-porsche-next);
    width: auto;
    height: var(--p-leading-normal);
    border-radius: var(--_p-legacy-radius-small, var(--p-radius-sm));
  }
  button span {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [popover] {
    all: unset;
    position: absolute;
    z-index: 99;
    padding: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    display: flex;
    flex-direction: column;
    gap: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    max-height: max(calc(224px), calc(50vh - 54px / 2 - 6px * 2));
    box-sizing: border-box;
    overflow: hidden auto;
    scrollbar-width: thin;
    scrollbar-color: auto;
    animation: var(--p-animation-duration, var(--p-duration-sm)) fade-in var(--p-ease-in-out) forwards;
    filter: drop-shadow(0 0 8px rgba(0,0,0,0.15));
    background: var(--p-color-canvas);
    border: 1px solid var(--p-color-contrast-low);
    border-radius: var(--_p-legacy-radius-medium, var(--p-radius-xl));
  }
  [popover]:not(:popover-open) {
    display: none;
  }
  ::slotted([slot="filter"]) {
    position: sticky !important;
    top: calc(calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px) * -1) !important;
    padding: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px) !important;
    margin: calc(calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px) * -1) !important;
    background: var(--p-color-canvas) !important;
    z-index: 1 !important;
  }
  slot[name="selected"] {
    display: block;
    height: 100%;
    flex-grow: 1;
    overflow: hidden;
  }
@media(forced-colors:active) {
    button {
      opacity: 1;
      color: GrayText;
    }
}

  .root {
    display: grid;
    gap: var(--p-spacing-static-xs);
    min-width: calc(1rem + var(--p-spacing-static-md) + 1px * 2 + calc(9px + var(--p-spacing-static-md) / 2 + (var(--p-leading-normal) + var(--p-spacing-static-xs) * 2) * 1));
  }
  .filter {
    position: sticky;
    top: calc(calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px) * -1);
    padding: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    margin: calc(calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px) * -1);
    background: var(--p-color-canvas);
    z-index: 1;
  }
  .options {
    display: flex;
    flex-direction: column;
    gap: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
  }
  .icon {
    margin-inline-end: -3px;
    pointer-events: none;
    transform: rotate3d(0,0,1,180deg);
    transition: transform var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  }
  .no-results {
    display: flex;
    gap: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    padding-block: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    padding-inline: var(--p-internal-select-option-padding-left, calc(16.8px * (var(--p-internal-select-scaling) - 0.64285714) + 6px)) calc(16.8px * (var(--p-internal-select-scaling) - 0.64285714) + 6px);
    min-height: var(--p-leading-normal);
    font: var(--p-font-weight-normal) var(--p-typescale-sm) / var(--p-leading-normal) var(--p-font-porsche-next);
    color: var(--p-color-contrast-medium);
    cursor: pointer;
    text-align: start;
    word-break: break-word;
    box-sizing: content-box;
    border-radius: var(--_p-legacy-radius-small, var(--p-radius-sm));
    transition: background-color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out), color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  }
  .no-results--highlighted {
    background: var(--p-color-frosted);
  }
  .no-results--highlighted, .no-results--selected {
    color: var(--p-color-primary);
  }
  .no-results--disabled {
    cursor: not-allowed;
  }
  .no-results--hidden {
    display: none;
  }
  .no-results[role=option] {
    cursor: not-allowed;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }
  .label-wrapper {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }
  .label {
    font: var(--p-font-weight-normal) var(--p-typescale-sm) / var(--p-leading-normal) var(--p-font-porsche-next);
    cursor: not-allowed;
    color: var(--p-color-primary);
    pointer-events: none;
    opacity: 0.4;
    transition: color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
    display: inline;
  }
  .label:empty {
    display: none;
  }
  .label:is(span) {
    cursor: unset;
    font-size: var(--p-typescale-xs);
    color: var(--p-color-contrast-high);
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    margin-top: calc(-1 * var(--p-spacing-static-xs));
  }
  .label > slot[name="label"]::slotted(*) {
    display: inline !important;
  }
  .required {
    user-select: none;
  }
  .message {
    display: flex;
    gap: var(--p-spacing-static-xs);
    font: var(--p-font-weight-normal) var(--p-typescale-sm) / var(--p-leading-normal) var(--p-font-porsche-next);
    transition: color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out), opacity var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  }
  .message:empty {
    opacity: 0;
    position: absolute;
  }
@media(forced-colors:active) {
    .no-results--disabled {
      color: GrayText;
    }
    .no-results--highlighted {
      forced-color-adjust: none;
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
    .label {
      opacity: 1;
      color: GrayText;
    }
}
"
`;
