    pointer-events: none;
    transform: rotate3d(0,0,1,0.0001deg);
    transition: transform var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  }
  .no-results {
    display: flex;
    gap: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    padding-block: calc(11.2px * (var(--p-internal-select-scaling) - 0.64285714) + 4px);
    padding-inline: var(--p-internal-select-option-padding-left, calc(16.8px * (var(--p-internal-select-scaling) - 0.64285714) + 6px)) calc(16.8px * (var(--p-internal-select-scaling) - 0.64285714) + 6px);
    min-height: var(--p-leading-normal);
    font: var(--p-font-weight-normal) var(--p-typescale-sm) / var(--p-leading-normal) var(--p-font-porsche-next);
    color: var(--p-color-contrast-medium);
    cursor: pointer;
    text-align: start;
    word-break: break-word;
    box-sizing: content-box;
    border-radius: var(--_p-legacy-radius-small, var(--p-radius-sm));
    transition: background-color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out), color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
  }
  .no-results--highlighted {
    background: var(--p-color-frosted);
  }
  .no-results--highlighted, .no-results--selected {
    color: var(--p-color-primary);
  }
  .no-results--disabled {
    cursor: not-allowed;
  }
  .no-results--hidden {
    display: none;
  }
  .no-results[role=option] {
    cursor: not-allowed;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }
  .label-wrapper {
    min-width: fit-content;
    position: static;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
  .label {
    font: var(--p-font-weight-normal) var(--p-typescale-sm) / var(--p-leading-normal) var(--p-font-porsche-next);
    cursor: pointer;
    color: var(--p-color-primary);
    transition: color var(--p-transition-duration, var(--p-duration-sm)) var(--p-ease-in-out);
    display: inline;
  }
  .label:empty {
    display: none;
  }
  .label:is(span) {
    cursor: unset;
    font-size: var(--p-typescale-xs);
    color: var(--p-color-contrast-high);
    position: static;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    margin-top: calc(-1 * var(--p-spacing-static-xs));
  }
