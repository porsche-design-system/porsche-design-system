.scroller {
  position: absolute;
  isolation: isolate;
  display: grid;
  inset-block: 0;
  inset-inline-end: 0;
  overflow: hidden auto;
  overscroll-behavior-y: none;
  background: rgba(255,255,255,.01);
  opacity: 0;
  transform: translateX(100%);
