  grid-column: 1/-1;
  z-index: 3;
  padding-inline: var(--p-spacing-fluid-lg);
  background-color: var(--_p-dialog-a);
}
dialog {
  all: unset;
  position: fixed;
  inset: 0;
  max-width: 100dvw;
  max-height: 100dvh;
  overflow: hidden;
  display: block;
  outline: 0;
  z-index: 9999999;
  width: 0px;
  height: 0px;
  visibility: hidden;
  pointer-events: none;
  overlay: none;
