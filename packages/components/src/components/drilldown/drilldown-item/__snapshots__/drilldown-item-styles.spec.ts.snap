// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`getComponentCss() > should return correct css for isPrimary: false, isSecondary: false and isCascade: false 1`] = `
"@keyframes slide-up-mobile {
  from {
    transform: translate3d(0,var(--p-spacing-fluid-md),0);
  }
  to {
    transform: translate3d(0,0,0);
  }
}
@keyframes slide-up-desktop-primary {
  from {
    margin-block-start: var(--p-spacing-fluid-md);
  }
  to {
    margin-block-start: 0px;
  }
}
@keyframes slide-up-desktop-secondary {
  from {
    margin-block-start: var(--p-spacing-fluid-md);
  }
  to {
    margin-block-start: 0px;
  }
}
  :host {
    display: contents;
  }
  :host([hidden]) {
    display: none !important;
  }
  :not(:defined,[data-ssr]) {
    visibility: hidden;
  }
  slot[name="header"] {
    display: none;
  }
  slot:not([name]) {
    display: none;
  }
  h2 {
    display: none;
  }
  ::slotted(*) {
    --p-drilldown-grid-template: auto/auto;
    --p-drilldown-gap: var(--p-spacing-fluid-xs);
  }
@media(min-width:760px) {
}

@media(max-width:759px) {
}

  .scroller {
    display: none;
    overflow: hidden auto;
    background: var(--_p-f);
  }
  .button {
    grid-column: 1/-1;
    padding: var(--p-spacing-fluid-sm);
    margin: 0 calc(var(--p-spacing-fluid-sm) * -1);
  }
  .back {
    display: none;
  }
@media(min-width:760px) {
    .drawer {
      display: none;
    }
}

@media(max-width:759px) {
    .drawer {
      display: none;
    }
}
"
`;

