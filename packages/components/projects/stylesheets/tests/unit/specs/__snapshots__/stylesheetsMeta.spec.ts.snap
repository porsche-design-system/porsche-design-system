".scheme-normal {
color-scheme: normal;
}

.scheme-dark {
color-scheme: dark;
}

.scheme-light {
color-scheme: light;
}

.scheme-light-dark {
color-scheme: light dark;
}

.scheme-only-dark {
color-scheme: only dark;
}

.scheme-only-light {
color-scheme: only light;
}

