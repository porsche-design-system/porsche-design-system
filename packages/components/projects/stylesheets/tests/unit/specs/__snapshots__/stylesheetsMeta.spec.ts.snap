  "cssVariables": {
    "description": "Exposes the design system **CSS variables** (custom properties) on \`:root\`, including theme-aware colors resolved via \`light-dark()\` and \`:lang()\` font overrides.",
    "file": "variables.css",
    "meta": [
      {
        "declarations": [
