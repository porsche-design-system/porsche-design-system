/* Simplified Chinese */
:lang(zh-Hans), :lang(zh-CN), :lang(zh-SG) {
--p-font-porsche-next: 'Porsche Next', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', 'Arial Narrow', Arial, sans-serif;
}

/* Traditional Chinese */
:lang(zh-Hant), :lang(zh-TW), :lang(zh-HK), :lang(zh-MO) {
--p-font-porsche-next: 'Porsche Next', 'PingFang TC', 'Microsoft JhengHei', 'Noto Sans TC', 'Arial Narrow', Arial, sans-serif;
}

/* Japanese */
:lang(ja) {
--p-font-porsche-next: 'Porsche Next', 'Hiragino Sans', 'Yu Gothic', 'Noto Sans JP', 'Arial Narrow', Arial, sans-serif;
}

/* Korean */
:lang(ko) {
--p-font-porsche-next: 'Porsche Next', 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', 'Arial Narrow', Arial, sans-serif;
}"
