{
  "name": "@porsche-design-system/docs-components",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "markdown": "./src/markdown.ts",
      "default": "./src/react.ts"
    },
    "./markdown": "./src/renderer/index.ts",
    "./markdown/jsx-runtime": "./src/renderer/jsx-runtime.ts",
    "./markdown/jsx-dev-runtime": "./src/renderer/jsx-dev-runtime.ts",
    "./register": "./src/renderer/register.mjs",
    "./utils": "./src/utils.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "npm run typecheck:tests && vitest run"
  },
  "dependencies": {
