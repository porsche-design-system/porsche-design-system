    "change-case": "^5.4.4",
    "hast-util-to-mdast": "^10.1.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0"
  },
  "peerDependencies": {
    "@porsche-design-system/components-react": "4.8.0",
    "next": "^16.3.6",
    "react": "^19.3.0"
  }
