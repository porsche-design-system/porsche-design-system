{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": []
  },
  // Everything, the stories, previews and descriptions included, which import the React wrapper's types: checked in
  // `build:site`, after the wrappers. tsconfig.catalogue.json checks the data before them.
  "include": ["src"],
  "exclude": ["node_modules"]
}
