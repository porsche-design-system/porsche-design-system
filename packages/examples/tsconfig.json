{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["mdx"]
  },
  // Everything, the example modules included, whose stories and previews import the React wrapper's types: checked in
  // `build:site`, after the wrappers. tsconfig.catalogue.json checks the data before them.
  "include": ["src", "generated"],
  "exclude": ["node_modules"]
}
