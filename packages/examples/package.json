{
  "name": "@porsche-design-system/examples",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/examples.d.ts",
      "default": "./dist/examples.js"
    },
    "./skill": {
      "types": "./skill/skill.ts",
      "default": "./skill/skill.ts"
    }
  },
  "scripts": {
    "start": "concurrently -k -s 'first' -n 'cdn,app' 'serve-cdn' 'vite'",
    "preview": "concurrently -k -s 'first' -n 'cdn,site' 'serve-cdn' 'tsx scripts/previewSite.ts'",
    "build": "npm run build:projects && npm run build:site",
    "build:projects": "tsx scripts/build.ts && npm run typecheck:projects && npm run build:export",
    "build:export": "rollup -c rollup.config.mjs",
    "build:site": "npm run typecheck && tsx scripts/buildSite.ts && npm run build:verify",
    "build:verify": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:projects": "tsc --noEmit -p tsconfig.projects.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:tests:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:tests:vrt": "tsc --noEmit -p tsconfig.vrt.json",
    "typecheck:tests:a11y": "tsc --noEmit -p tsconfig.a11y.json",
    "test": "npm run test:unit && npm run test:e2e && npm run test:a11y && npm run test:vrt",
    "test:unit": "npm run typecheck:tests && vitest run",
    "test:a11y": "npm run typecheck:tests:a11y && playwright test --project='a11y-*'",
    "test:e2e": "npm run typecheck:tests:e2e && playwright test --project='e2e-*'",
    "test:vrt": "npm run typecheck:tests:vrt && playwright test --project='vrt-*'",
    "test:vrt:chrome": "npm run typecheck:tests:vrt && playwright test --project=vrt-desktop-chrome",
    "test:vrt:safari": "npm run typecheck:tests:vrt && playwright test --project=vrt-mobile-safari",
    "posttest:vrt:chrome": "npm run test:vrt:prepare-regression-snapshots",
    "posttest:vrt:safari": "npm run test:vrt:prepare-regression-snapshots",
    "posttest:vrt": "npm run test:vrt:prepare-regression-snapshots",
    "test:vrt:prepare-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/results --mode prepare",
    "test:vrt:update-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/specs/__screenshots__ --mode update",
    "clean:build": "rm -rf ./dist ./dist-site ./generated"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@porsche-design-system/component-meta": "0.0.0",
    "@porsche-design-system/components": "4.8.0",
    "@porsche-design-system/components-js": "4.8.0",
    "@porsche-design-system/shared": "0.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "fast-glob": "^3.3.3",
    "lightningcss": "^1.33.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
