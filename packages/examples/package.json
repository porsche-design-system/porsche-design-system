{
  "name": "@porsche-design-system/examples",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s 'first' -n 'cdn,app' 'serve-cdn' 'vite'",
    "start": "npm run dev",
    "preview:patterns": "concurrently -k -s 'first' -n 'cdn,patterns' 'serve-cdn' 'tsx scripts/previewProject.ts patterns'",
    "preview:templates": "concurrently -k -s 'first' -n 'cdn,templates' 'serve-cdn' 'tsx scripts/previewProject.ts templates'",
    "preview:patterns:app": "tsx scripts/previewProject.ts patterns --no-open",
    "preview:templates:app": "tsx scripts/previewProject.ts templates --no-open",
    "build": "tsx scripts/build.ts",
    "build:verify": "tsx scripts/verify.ts",
    "lint": "biome lint",
    "test": "npm run test:unit && npm run test:vrt",
    "test:unit": "vitest run",
    "pretest:vrt": "npm run build",
    "test:vrt": "playwright test --config=tests/vrt/config/playwright.config.ts",
    "test:vrt:chrome": "npm run test:vrt -- --project=chrome",
    "test:vrt:safari": "npm run test:vrt -- --project=safari",
    "posttest:vrt": "npm run test:vrt:prepare-regression-snapshots",
    "posttest:vrt:chrome": "npm run test:vrt:prepare-regression-snapshots",
    "posttest:vrt:safari": "npm run test:vrt:prepare-regression-snapshots",
    "test:vrt:prepare-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/results --mode prepare",
    "test:vrt:update-regression-snapshots": "prepare-vrt-snapshots --source tests/vrt/results --output tests/vrt/specs/__screenshots__ --mode update",
    "clean:build": "rm -rf ./dist ./dist-tmp"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@porsche-design-system/components": "4.6.0-rc.1",
    "@porsche-design-system/components-js": "4.6.0-rc.1",
    "@porsche-design-system/shared": "0.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "fast-glob": "^3.3.3",
    "lightningcss": "^1.33.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
