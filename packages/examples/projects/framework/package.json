{
  "name": "@porsche-design-system/examples-framework",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./generated/index.ts",
      "default": "./generated/index.ts"
    },
    "./previews": {
      "types": "./generated/previews/index.ts",
      "default": "./generated/previews/index.ts"
    },
    "./previews/*": {
      "types": "./generated/previews/*.tsx",
      "default": "./generated/previews/*.tsx"
    }
  },
  "scripts": {
    "build": "npm run clean:build && tsx scripts/build.ts && npm run typecheck:data",
    "clean:build": "rm -rf ./generated",
    "typecheck": "npm run typecheck:data && npm run typecheck:previews",
    "typecheck:data": "tsc --noEmit -p tsconfig.json",
    "typecheck:previews": "tsc --noEmit -p tsconfig.previews.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint",
    "test": "npm run test:unit",
    "test:unit": "npm run typecheck:tests && vitest run"
  },
  "dependencies": {
    "change-case": "^5.4.4"
  },
  "peerDependencies": {
    "@porsche-design-system/components-react": "4.8.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@porsche-design-system/components-react": "4.8.0",
    "@porsche-design-system/shared": "0.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
