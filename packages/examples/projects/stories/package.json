{
  "name": "@porsche-design-system/examples-stories",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./generated/index.ts",
      "default": "./generated/index.ts"
    },
    "./examples/*": {
      "types": "./generated/examples/*.ts",
      "default": "./generated/examples/*.ts"
    },
    "./*.mdx": "./src/*.mdx",
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "npm run clean:build && tsx scripts/build.ts && npm run typecheck:data",
    "clean:build": "rm -rf ./generated",
    "typecheck": "npm run typecheck:data && npm run typecheck:self && npm run typecheck:scripts",
    "typecheck:data": "tsc --noEmit -p tsconfig.data.json",
    "typecheck:self": "tsc --noEmit -p tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome lint"
  },
  "dependencies": {
    "@porsche-design-system/assets": "5.0.2",
    "@porsche-design-system/flags": "0.0.0",
    "@porsche-design-system/story-generator": "0.0.0",
    "change-case": "^5.4.4"
  },
  "devDependencies": {
    "@porsche-design-system/components-react": "4.10.0",
    "@porsche-design-system/shared": "0.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
