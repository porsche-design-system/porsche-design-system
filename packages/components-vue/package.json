{
  "name": "@porsche-design-system/vue",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k -s 'first' -n 'cdn,dummyassets,vue' 'serve-cdn' 'serve-dummyassets' 'vite -c vite.config.app.mts'",
    "start-app": "concurrently -k -s 'first' -n 'cdn,dummyassets,app' 'serve-cdn' 'serve-dummyassets' 'ws --spa index.html -p 5173 -d ./dist/demo-app'",
    "build": "npm run clean:build && npm run build:vue-wrapper && npm run build:subPackages",
    "build:vue-wrapper": "npm run build:vue-wrapper:lib && npm run build:vue-wrapper:typings",
    "build:vue-wrapper:lib": "vite build -c vite.config.package.mts && cp ../../LICENSE.md ../../OSS_NOTICE projects/vue-wrapper/README.md projects/vue-wrapper/package.json ../components/CHANGELOG.md dist/vue-wrapper/",
    "build:vue-wrapper:typings": "vue-tsc --emitDeclarationOnly && tsx scripts/addDeprecatedAnnotations.ts",
    "build:subPackages": "npm run build:subPackages:lib && npm run build:subPackages:global-styles && npm run build:subPackages:tailwindcss && npm run build:subPackages:vanilla-extract && npm run build:subPackages:typings",
    "build:subPackages:lib": "npx rollup -c ./projects/vue-wrapper/rollup.config.js --bundleConfigAsCjs",
    "build:subPackages:tailwindcss": "TARGET=./dist/vue-wrapper/tailwindcss && rm -rf $TARGET && cp -r ../styles/projects/tailwindcss/dist $TARGET",
    "build:subPackages:vanilla-extract": "TARGET=./dist/vue-wrapper/vanilla-extract && rm -rf $TARGET && cp -r ../styles/projects/vanilla-extract/dist $TARGET",
    "build:subPackages:global-styles": "TARGET=./dist/vue-wrapper/global-styles && rm -rf $TARGET && cp -r ../styles/projects/global-styles/dist $TARGET",
    "build:subPackages:typings": "npm run build:subPackages:typings:jsdom-polyfill && npm run build:subPackages:typings:partials && npm run build:subPackages:typings:testing && npm run build:subPackages:typings:tokens && npm run build:subPackages:typings:emotion && npm run build:subPackages:typings:vanilla-extract && npm run build:subPackages:typings:ag-grid",
    "build:subPackages:typings:jsdom-polyfill": "tsc projects/vue-wrapper/src/jsdom-polyfill/index.ts --declaration --emitDeclarationOnly --declarationDir dist/vue-wrapper/jsdom-polyfill --types node --ignoreConfig",
    "build:subPackages:typings:partials": "tsc projects/vue-wrapper/src/partials/index.ts --declaration --emitDeclarationOnly --declarationDir dist/vue-wrapper/partials/esm --types node --skipLibCheck true --ignoreConfig",
    "build:subPackages:typings:testing": "tsc projects/vue-wrapper/src/testing/index.ts --declaration --emitDeclarationOnly --declarationDir dist/vue-wrapper/testing --types node --ignoreConfig",
    "build:subPackages:typings:tokens": "tsc projects/vue-wrapper/src/tokens/index.ts --declaration --emitDeclarationOnly --declarationDir dist/vue-wrapper/tokens/esm --types node --ignoreConfig",
    "build:subPackages:typings:emotion": "tsc projects/vue-wrapper/src/emotion/index.ts --declaration --emitDeclarationOnly --declarationDir dist/vue-wrapper/emotion/esm --types node --ignoreConfig",
    "build:subPackages:typings:vanilla-extract": "tsc projects/vue-wrapper/src/vanilla-extract/index.ts --declaration --emitDeclarationOnly --declarationDir dist/vue-wrapper/vanilla-extract/esm --types node --ignoreConfig",
    "build:subPackages:typings:ag-grid": "tsc projects/vue-wrapper/src/ag-grid/index.ts --declaration --emitDeclarationOnly --declarationDir dist/vue-wrapper/ag-grid/esm --types node --ignoreConfig",
    "build-app": "vue-tsc --noEmit --project tsconfig.app.json && vite build -c vite.config.app.mts",
    "test": "npm run test:unit && npm run test:e2e && npm run test:vrt && npm run test:smoke",
    "test:unit": "npm run test:unit:vue-wrapper",
    "test:unit:vue-wrapper": "vitest --config projects/vue-wrapper/tests/unit/config/vitest.config.ts",
    "test:e2e": "npm run build-app && playwright test --config=tests/e2e/config/playwright.config.ts",
    "test:vrt": "playwright test --config=tests/vrt/config/playwright.config.ts",
    "test:smoke": "npm run test:smoke:unit && npm run test:smoke:vue-wrapper",
    "test:smoke:unit": "vitest --config tests/smoke/unit/config/vitest.config.ts",
    "test:smoke:vue-wrapper": "vitest --config projects/vue-wrapper/tests/smoke/config/vitest.config.ts",
    "clean:build": "rm -rf ./dist"
  },
  "dependencies": {
    "@porsche-design-system/components-vue": "4.1.0",
    "vue-imask": "^7.6.1",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@porsche-design-system/assets": "5.0.2",
    "@porsche-design-system/shared": "0.0.0",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node18": "^18.2.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "0.9.1",
    "ag-grid-community": "35.2.1",
    "ag-grid-enterprise": "35.2.1",
    "ag-grid-vue3": "35.2.1",
    "local-web-server": "^5.4.0",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "3.2.6"
  },
  "peerDependencies": {
    "vue": "*",
    "@playwright/test": "*",
    "change-case": "*",
    "concurrently": "*",
    "fast-glob": "*",
    "tsx": "*",
    "typescript": "*",
    "vite": "*",
    "tailwindcss": "*",
    "postcss": "*",
    "@tailwindcss/postcss": "*"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
