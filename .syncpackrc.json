{
  "$schema": "./node_modules/syncpack/schema.json",
  "sortFirst": [
    "name",
    "version",
    "private",
    "license",
    "scope",
    "repository",
    "bugs",
    "funding",
    "author",
    "homepage",
    "description",
    "keywords",
    "workspaces",
    "sideEffects",
    "type",
    "exports",
    "main",
    "module",
    "collection",
    "collection:main",
    "es2015",
    "es2017",
    "jsnext:main",
    "types",
    "browser",
    "style",
    "bin",
    "files",
    "engines",
    "packageManager",
    "scripts",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "peerDependenciesMeta",
    "optionalDependencies",
    "overrides",
    "volta"
  ],
  "sortAz": ["dependencies", "devDependencies", "peerDependencies"],
  "updateGroups": [
    {
      "label": "Held-back dependencies — upgraded deliberately, not via automated checks (see docs/dependencies.md and .github/dependabot.yml)",
      "dependencies": ["@porsche-design-system/**", "@playwright/test", "@stencil/core"],
      "isIgnored": true
    },
    {
      "label": "Framework/styling families — minor/patch only; majors upgraded by hand (see docs/dependencies.md)",
      "dependencies": [
        "@angular/**",
        "ng-packagr",
        "zone.js",
        "ag-grid-*",
        "@ag-grid-community/**",
        "react",
        "react-dom",
        "react-router",
        "react-router-dom",
        "@react-router/**",
        "@types/react",
        "@types/react-dom",
        "vue",
        "vue-router",
        "vue-tsc",
        "@vue/**",
        "@vitejs/plugin-vue",
        "tailwindcss",
        "@tailwindcss/**",
        "sass",
        "@emotion/**",
        "@vanilla-extract/**"
      ],
      "target": "minor"
    }
  ]
}
