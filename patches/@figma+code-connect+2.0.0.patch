+/**
+ * PDS patch: parserless templates carry no `templateData.props`, so `validateProps` (validation.js) returns at its
+ * guard for them and a template that reads a property the Figma component does not have publishes as "valid". Read
+ * every `instance.getString/getBoolean/getEnum('<name>')` call out of the compiled template into the `{ kind, args:
+ * { figmaPropName } }` shape `validateProps` reads (it checks the name only), so publish and --dry-run compare those
+ * names against the live component. `validateProps` is widened to accept the `slot` and `instance` kinds, and to
+ * compare a getEnum value list with the Figma variant's options in both directions.
+ */
+function extractPropertyReads(template) {
+    const kinds = { getString: 'string', getBoolean: 'boolean', getEnum: 'enum', getSlot: 'slot', getInstanceSwap: 'instance' };
+    const props = {};
+    const re = /\.(getString|getBoolean|getEnum|getSlot|getInstanceSwap)\(\s*(['"])((?:(?!\2).)+)\2/g;
+    let match;
+    while ((match = re.exec(template)) !== null) {
+        const figmaPropName = match[3];
+        props[figmaPropName] = { kind: kinds[match[1]], args: { figmaPropName } };
+    }
+    // The value list of a getEnum call, as the generator writes it: `{ key: 'value', 'other-key': 'value', false: false }`
+    // with no nested braces. Its keys are the Figma variant options the template handles.
+    const enums = /\.getEnum\(\s*(['"])((?:(?!\1).)+)\1\s*,\s*\{([^}]*)\}/g;
+    while ((match = enums.exec(template)) !== null) {
+        const valueMapping = {};
+        for (const entry of match[3].split(',')) {
+            const colon = entry.indexOf(':');
+            if (colon === -1) continue;
+            const key = entry.slice(0, colon).trim().replace(/^(['"])(.*)\1$/, '$2');
+            if (key) valueMapping[key] = entry.slice(colon + 1).trim();
+        }
+        if (props[match[2]]) props[match[2]].args.valueMapping = valueMapping;
+    }
+    return Object.keys(props).length ? props : undefined;
+}
