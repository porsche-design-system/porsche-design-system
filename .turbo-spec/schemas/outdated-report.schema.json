{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Outdated dependency report",
  "description": "Machine-readable output of `syncpack update --check`, produced deterministically by parse-outdated.mjs.",
  "type": "object",
  "required": ["updates_exist", "dependencies"],
  "additionalProperties": true,
  "properties": {
    "generated_at": { "type": "string" },
    "updates_exist": { "type": "boolean" },
    "summary": {
      "type": ["object", "null"],
      "properties": {
        "major": { "type": "integer" },
        "minor": { "type": "integer" },
        "patch": { "type": "integer" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "from", "to", "instances", "bump"],
        "properties": {
          "name": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "instances": { "type": "integer" },
          "bump": { "type": "string", "enum": ["major", "minor", "patch", "other"] }
        }
      }
    },
    "overrides_skipped": {
      "type": "array",
      "description": "Deps reported by syncpack that live only in overrides/resolutions (hand-curated security pins). Never auto-bumped; surfaced for manual review.",
      "items": {
        "type": "object",
        "required": ["name", "from", "to"],
        "properties": {
          "name": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    }
  }
}
