# http://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# css`` styles files are formatted by Prettier (see .prettierignore allowlist + prettier.config.js).
# Disable the IDE's native formatter there so "Reformat Code" cannot rewrite template-literal CSS
[packages/components/src/{**/*-styles.ts,styles/**/*.ts}]
ij_formatter_enabled = false